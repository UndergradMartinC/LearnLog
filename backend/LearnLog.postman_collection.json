    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{signupEmail}}\",\n  \"password\": \"{{signupPassword}}\",\n  \"name\": \"API Signup User {{$timestamp}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const ts = Date.now();",
                  "const generatedEmail = `apiuser${ts}@example.com`;",
                  "const generatedPassword = `Passw0rd!${ts}`;",
                  "",
                  "pm.collectionVariables.set('signupEmail', generatedEmail);",
                  "pm.collectionVariables.set('signupPassword', generatedPassword);",
                  "",
                  "// Mirror onto login vars so the next Login request can reuse these credentials.",
                  "pm.collectionVariables.set('email', generatedEmail);",
                  "pm.collectionVariables.set('password', generatedPassword);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 or 201', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "const createdId = json.id ? String(json.id) : '';",
                  "const createdEmail = pm.collectionVariables.get('signupEmail') || '';",
                  "",
                  "pm.test('Signup response has created user id', function () {",
                  "  pm.expect(createdId).to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "pm.collectionVariables.set('signupUserId', createdId);",
                  "pm.collectionVariables.set('signupEmail', createdEmail);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "login"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "const token = json.token;",
                  "const userId = json.user && typeof json.user.id === 'number' ? json.user.id : null;",
                  "",
                  "pm.test('Login response has token', function () {",
                  "  pm.expect(token).to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "pm.test('Login response has numeric user id', function () {",
                  "  pm.expect(userId).to.be.a('number');",
                  "});",
                  "",
                  "pm.collectionVariables.set('authToken', token);",
                  "pm.collectionVariables.set('userId', userId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "me"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "const currentUserId = json.user && typeof json.user.id === 'number' ? json.user.id : null;",
                  "",
                  "pm.test('Current user exists', function () {",
                  "  pm.expect(currentUserId).to.be.a('number');",
                  "});",
                  "",
                  "if (currentUserId !== null) {",
                  "  pm.collectionVariables.set('userId', currentUserId);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
