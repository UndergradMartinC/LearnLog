---
interface Props {
  label?: string;
  hiddenInputId?: string;
  inputId?: string;
  placeholder?: string;
  helperText?: string;
  initialTags?: string[];
  availableTags?: { id: number; name: string }[];
}

const {
  label = 'Tags',
  hiddenInputId = 'selected-tags',
  inputId = 'tag-input',
  placeholder = 'Type a tag and press Enter',
  helperText = 'Press Enter to add each tag. Backspace on empty input removes the last tag.',
  initialTags = [],
  availableTags = [],
} = Astro.props;
---

<label class="tag-field" data-tag-input>
  {label}
  <input id={hiddenInputId} name={hiddenInputId} type="hidden" value={JSON.stringify(initialTags)} />
  <div class="tag-builder">
    <select id="tag-select">
        <option value="">Select a tag</option>
        {availableTags.map(tag => (
            <option value={tag.id}>{tag.name}</option>
        ))}
    </select>
  </div>
  <small class="message">{helperText}</small>
</label>

<style>
.tag-field {
  display: grid;
  gap: 0.4rem;
  font-size: 0.9rem;
}

.tag-builder {
  border: 1px solid var(--color-border);
  border-radius: 8px;
  background: #fff;
  padding: 0.5rem;
  display: flex;
  flex-wrap: wrap;
  gap: 0.45rem;
  cursor: text;
}

:global(.tag-chip) {
  display: inline-flex !important;
  align-items: center;
  background: #cbd6c3;
  color: #2d2d2d;
  border: 1px solid #94a3b8;
  border-radius: 8px;
  padding: 0.24rem 0.6rem;
  font-size: 0.84rem;
  line-height: 1.1;
  white-space: nowrap;
  align-self: flex-start;
  cursor: pointer;
}

:global(.tag-chip-label) {
  display: inline-block;
  color: inherit;
  line-height: 1.1;
}

.tag-input {
  border: none;
  padding: 0.35rem 0.25rem;
  min-width: 140px;
  flex: 1;
}

.tag-input:focus {
  outline: none;
}

</style>

<script>
document.querySelectorAll('[data-tag-input]').forEach((root) => {
  const hiddenInput = root.querySelector('input[type="hidden"]');
  const builder = root.querySelector('.tag-builder');
  const select = root.querySelector('#tag-select');

  if (!hiddenInput || !builder || !select) return;

  const selectedTags = [];

  const syncHidden = () => {
    hiddenInput.value = JSON.stringify(selectedTags);
  };

  const renderTags = () => {
    builder.querySelectorAll('.tag-chip').forEach(el => el.remove());

    selectedTags.forEach((tag) => {
      const chip = document.createElement('div');
      chip.className = 'tag-chip';

      const text = document.createElement('span');
      text.className = 'tag-chip-label';
      text.textContent = String(tag);

      chip.appendChild(text);
      builder.appendChild(chip);
    });
  };

  select.addEventListener('change', () => {
    const value = select.value;
    if (!value) return;

    const id = Number(value);

    if (!selectedTags.includes(id)) {
      selectedTags.push(id);
      syncHidden();
      renderTags();
    }

    select.value = '';
  });

  syncHidden();
  renderTags();
});
</script>
