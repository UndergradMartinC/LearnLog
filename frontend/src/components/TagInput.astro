---
interface Props {
  label?: string;
  hiddenInputId?: string;
  inputId?: string;
  placeholder?: string;
  helperText?: string;
  initialTags?: number[];
  availableTags?: { id: number; name: string }[];
}

const {
  label = 'Tags',
  hiddenInputId = 'selected-tags',
  inputId = 'tag-input',
  placeholder = 'Select a tag',
  helperText = 'Choose a tag from the list. Click a selected tag to remove it.',
  initialTags = [],
  availableTags = [],
} = Astro.props;
---

<label
  class="tag-field"
  data-tag-input
  data-available-tags={JSON.stringify(availableTags)}
  data-initial-tags={JSON.stringify(initialTags)}
>
  {label}
  <input
    id={hiddenInputId}
    name={hiddenInputId}
    type="hidden"
    value={JSON.stringify(initialTags)}
  />

  <div class="tag-builder">
    
    <div class="tag-select-wrap">
        <select id={inputId} class="tag-select">
            <option value="">{placeholder}</option>
            {availableTags.map((tag) => (
                <option value={String(tag.id)}>{tag.name}</option>
            ))}
        </select>
        <img src="/images/down-arrow.png" class="tag-select-arrow" alt="" />
    </div>
    <div class="tag-chip-list" data-tag-chip-list></div>
  </div>

  <small class="message">{helperText}</small>
</label>

<style>
.tag-field {
  display: grid;
  gap: 0.4rem;
  font-size: 0.9rem;
}

.tag-builder {
  border: 1px solid var(--color-border);
  border-radius: 8px;
  background: #fff;
  padding: 0.5rem;
  display: flex;
  flex-wrap: wrap;
  gap: 0.45rem;
  align-items: center;
}

.tag-chip-list {
  display: flex;
  flex-wrap: wrap;
  gap: 0.45rem;
}

.tag-select {
  appearance: none;
  -webkit-appearance: none;
  -moz-appearance: none;

  border: 1px solid var(--color-border);
  border-radius: 999px;

  
  padding: 0.25rem 1.6rem 0.25rem 0.6rem;
  font-size: 0.84rem;
  line-height: 1.1;

  height: 28px;           
  min-height: 26px;

  background: #f8f8f6;
  font: inherit;
  cursor: pointer;
  transition: all 0.15s ease;
}
.tag-select-arrow {
  position: absolute;
  right: 0.75rem;
  width: 12px;
  height: 12px;
  pointer-events: none;
  opacity: 0.7;
}
.tag-select:hover {
  background: #f3f3ef;
  border-color: #cfcbbd;
}

.tag-select:focus {
  outline: none;
  border-color: #94a3b8;
  box-shadow: 0 0 0 3px rgba(148, 163, 184, 0.2);
}
.tag-select:focus-visible {
  outline: none;
}

.tag-select-wrap {
  position: relative;
  display: inline-flex;
  align-items: center;
}

:global(.tag-chip) {
  display: inline-flex !important;
  align-items: center;
  gap: 0.4rem;
  background: #cbd6c3;
  color: #2d2d2d;
  border: 1px solid #94a3b8;
  border-radius: 999px;
  padding: 0.32rem 0.7rem;
  font-size: 0.84rem;
  line-height: 1.1;
  white-space: nowrap;
  align-self: flex-start;
  cursor: pointer;
}

:global(.tag-chip-label) {
  display: inline-block;
  color: inherit;
  line-height: 1.1;
}

:global(.tag-chip-remove) {
  font-size: 0.82rem;
  line-height: 1;
  opacity: 0.7;
}
</style>

<script>
document.querySelectorAll<HTMLElement>('[data-tag-input]').forEach((root) => {
  const hiddenInput = root.querySelector<HTMLInputElement>('input[type="hidden"]');
  const chipList = root.querySelector('[data-tag-chip-list]');
  const select = root.querySelector<HTMLSelectElement>('.tag-select');

  if (!hiddenInput || !chipList || !select) return;

  const availableTags = JSON.parse(root.dataset.availableTags || '[]');
  const initialTags = JSON.parse(root.dataset.initialTags || '[]');

  const selectedTags = Array.isArray(initialTags)
    ? initialTags.map(Number).filter(Number.isFinite)
    : [];

  const syncHidden = () => {
    hiddenInput.value = JSON.stringify(selectedTags);
  };

  const getTagName = (tagId: number) => {
    const tag = availableTags.find((t: { id: number; name: string }) => Number(t.id) === Number(tagId));
    return tag ? tag.name : String(tagId);
  };

  const renderTags = () => {
    chipList.innerHTML = '';

    selectedTags.forEach((tagId) => {
      const chip = document.createElement('button');
      chip.type = 'button';
      chip.className = 'tag-chip';
      const getColorFromId = (id: number) => {
        const hue = (id * 137) % 360; // nice distribution
        return `hsl(${hue}, 70%, 85%)`;
      };

      const getBorderFromId = (id: number) => {
        const hue = (id * 137) % 360;
        return `hsl(${hue}, 50%, 60%)`;
      };

      chip.style.backgroundColor = getColorFromId(tagId);
      chip.style.borderColor = getBorderFromId(tagId);
      chip.title = 'Click to remove';

      const text = document.createElement('span');
      text.className = 'tag-chip-label';
      text.textContent = getTagName(tagId);

      const removeMark = document.createElement('span');
      removeMark.className = 'tag-chip-remove';
      removeMark.textContent = 'x';

      chip.appendChild(text);
      chip.appendChild(removeMark);

      chip.addEventListener('click', () => {
        const index = selectedTags.indexOf(tagId);
        if (index > -1) {
          selectedTags.splice(index, 1);
          syncHidden();
          renderTags();
        }
      });

      chipList.appendChild(chip);
    });
  };

  select.addEventListener('change', () => {
    const value = select.value;
    if (!value) return;

    const id = Number(value);

    if (!selectedTags.includes(id)) {
      selectedTags.push(id);
      syncHidden();
      renderTags();
    }

    select.value = '';
  });

  syncHidden();
  renderTags();
});
</script>