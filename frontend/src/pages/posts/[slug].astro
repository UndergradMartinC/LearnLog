---
import { payloadAuthHeaders } from '../../lib/server-auth';

const { slug } = Astro.params;
const PAYLOAD_URL = import.meta.env.PAYLOAD_BACKEND_URL ?? 'http://localhost:3000';
const cookie = Astro.request.headers.get('cookie') ?? '';
const authHeaders = payloadAuthHeaders(cookie);

const authRes = await fetch(`${PAYLOAD_URL}/api/users/me`, { headers: authHeaders });
if (!authRes.ok) return Astro.redirect('/login');
const meData = await authRes.json();
const me = meData.user ?? meData;

const postRes = await fetch(
  `${PAYLOAD_URL}/api/posts?where[slug][equals]=${slug}&depth=1`,
  { headers: authHeaders }
);
if (!postRes.ok) return Astro.redirect('/dashboard');
const postData = await postRes.json();
const post = postData.docs?.[0];
if (!post) return Astro.redirect('/dashboard');

// Lexical rich text → HTML serializer
function renderNodes(nodes: any[]): string {
  return (nodes ?? []).map(renderNode).join('');
}

function renderNode(node: any): string {
  switch (node.type) {
    case 'paragraph':
      return `<p>${renderNodes(node.children)}</p>`;
    case 'heading':
      return `<${node.tag}>${renderNodes(node.children)}</${node.tag}>`;
    case 'text': {
      let t = node.text ?? '';
      if (node.format & 1)  t = `<strong>${t}</strong>`;
      if (node.format & 2)  t = `<em>${t}</em>`;
      if (node.format & 8)  t = `<u>${t}</u>`;
      if (node.format & 16) t = `<s>${t}</s>`;
      return t;
    }
    case 'link':
      return `<a href="${node.url ?? '#'}">${renderNodes(node.children)}</a>`;
    case 'list':
      return node.listType === 'number'
        ? `<ol>${renderNodes(node.children)}</ol>`
        : `<ul>${renderNodes(node.children)}</ul>`;
    case 'listitem':
      return `<li>${renderNodes(node.children)}</li>`;
    case 'quote':
      return `<blockquote>${renderNodes(node.children)}</blockquote>`;
    case 'linebreak':
      return '<br>';
    default:
      return renderNodes(node.children ?? []);
  }
}

let bodyHtml = '';
if (typeof post.body === 'string') {
  // Plain string — escape and wrap in a paragraph
  bodyHtml = `<p>${post.body.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')}</p>`;
} else if (post.body?.root?.children) {
  // Lexical JSON (created via admin rich-text editor)
  bodyHtml = renderNodes(post.body.root.children);
}
const postDate = post.publishedAt ?? post.createdAt;
const authorName = post.author?.name ?? post.author?.email ?? 'Unknown';
const title = `${post.title} | LearnLog`;

// Reactions initial state
const likeCount    = (post.likes    ?? []).length;
const dislikeCount = (post.dislikes ?? []).length;
const userHasLiked    = (post.likes    ?? []).some((u: any) => (u?.id ?? u) === me.id);
const userHasDisliked = (post.dislikes ?? []).some((u: any) => (u?.id ?? u) === me.id);
const isAuthor = !!me?.id && me.id === (post.author?.id ?? post.author);
---

<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;1,400&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&display=swap" rel="stylesheet" />

<style is:global>
* { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --font-serif: 'Lora', Georgia, serif;
  --font-sans: 'DM Sans', system-ui, sans-serif;

  --text-xs:   0.6875rem;
  --text-sm:   0.8125rem;
  --text-base: 1rem;
  --text-lg:   1.125rem;
  --text-xl:   1.75rem;
  --text-2xl:  2.25rem;

  --color-bg:         #f7f6f3;
  --color-surface:    #ffffff;
  --color-border:     #e4e2db;
  --color-text:       #2d2d2d;
  --color-text-2:     #5e6278;
  --color-text-muted: #9090a0;
  --color-accent:     #3d5a78;
  --color-accent-ring: rgba(61,90,120,0.08);
  --color-danger:      #b91c1c;
  --color-danger-dark: #991b1b;
}

body {
  font-family: var(--font-sans);
  font-size: var(--text-base);
  line-height: 1.6;
  margin: 0;
  background: var(--color-bg);
  color: var(--color-text);
  font-kerning: normal;
  -webkit-font-smoothing: antialiased;
}

.navbar {
  display: flex; justify-content: space-between; align-items: center;
  padding: 1.125rem 2.5rem;
  background: var(--color-surface);
  border-bottom: 1px solid var(--color-border);
  position: relative; z-index: 10;
}
.logo {
  font-family: var(--font-serif);
  font-size: 1.25rem;
  font-weight: 600;
  color: var(--color-text);
  letter-spacing: -0.01em;
  text-decoration: none;
}
.nav-links { display: flex; align-items: center; }
.nav-links a {
  margin-left: 1.25rem;
  color: var(--color-text-2);
  font-size: var(--text-sm);
  font-weight: 500;
  text-decoration: none;
  transition: color 0.12s;
}
.nav-links a:hover { color: var(--color-text); }
.logout-btn {
  margin-left: 1.25rem;
  background: transparent;
  color: var(--color-text-muted);
  border: none;
  padding: 0.5rem 0;
  font-family: var(--font-sans);
  font-size: var(--text-sm);
  font-weight: 500;
  cursor: pointer;
  transition: color 0.12s;
}
.logout-btn:hover { color: var(--color-text); }

/* Post layout */
.post-container {
  max-width: 42rem;
  margin: 3rem auto;
  padding: 0 1.5rem;
}

.back-link {
  display: inline-flex;
  align-items: center;
  gap: 0.375rem;
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  text-decoration: none;
  margin-bottom: 2.5rem;
}
.back-link:hover { color: var(--color-text-2); }

/* Post header */
.post-header { margin-bottom: 2.5rem; }

.post-title {
  font-family: var(--font-serif);
  font-size: var(--text-2xl);
  font-weight: 600;
  color: var(--color-text);
  line-height: 1.2;
  letter-spacing: -0.02em;
  margin-bottom: 1rem;
}

.post-deck {
  font-size: var(--text-lg);
  color: var(--color-text-2);
  line-height: 1.55;
  margin-bottom: 1.25rem;
  font-family: var(--font-serif);
  font-style: italic;
}

.post-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 0.5rem;
  padding-bottom: 1.5rem;
  border-bottom: 1px solid var(--color-border);
}
.post-meta-left {
  display: flex;
  gap: 0.75rem;
  align-items: center;
  flex-wrap: wrap;
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  font-variant-numeric: tabular-nums;
}

.badge {
  font-size: var(--text-xs);
  font-weight: 600;
  padding: 0.125rem 0.5rem;
  border-radius: 99px;
  text-transform: uppercase;
  letter-spacing: 0.06em;
}
.badge-published { background: #ecfdf5; color: #16a34a; }
.badge-draft     { background: #fefce8; color: #a16207; }

.post-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.375rem;
  margin-top: 1rem;
}
.tag {
  font-size: var(--text-xs);
  font-weight: 500;
  color: var(--color-text-2);
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: 99px;
  padding: 0.1rem 0.55rem;
  letter-spacing: 0.01em;
}

/* Prose (rendered rich text) */
.prose {
  font-family: var(--font-serif);
  font-size: var(--text-base);
  line-height: 1.8;
  color: var(--color-text);
  max-width: 65ch;
}
.prose p { margin-bottom: 1.25rem; }
.prose h1, .prose h2, .prose h3,
.prose h4, .prose h5, .prose h6 {
  font-family: var(--font-serif);
  font-weight: 600;
  color: var(--color-text);
  letter-spacing: -0.01em;
  line-height: 1.25;
  margin: 2rem 0 0.75rem;
}
.prose h1 { font-size: 1.75rem; }
.prose h2 { font-size: 1.375rem; }
.prose h3 { font-size: 1.125rem; }
.prose ul, .prose ol { padding-left: 1.5rem; margin-bottom: 1.25rem; }
.prose li { margin-bottom: 0.375rem; }
.prose blockquote {
  border-left: 3px solid var(--color-border);
  padding-left: 1.25rem;
  margin: 1.5rem 0;
  color: var(--color-text-2);
  font-style: italic;
}
.prose a { color: var(--color-accent); text-underline-offset: 3px; }
.prose strong { font-weight: 600; }

/* ── Reactions ── */
.reaction-bar {
  display: flex;
  gap: 0.625rem;
  align-items: center;
  margin: 2rem 0 0;
  padding: 1.25rem 0;
  border-top: 1px solid var(--color-border);
}
.reaction-btn {
  background: none;
  border: 1px solid var(--color-border);
  border-radius: 99px;
  padding: 0.35rem 1rem;
  font-family: var(--font-sans);
  font-size: var(--text-sm);
  font-weight: 500;
  color: var(--color-text-muted);
  cursor: pointer;
  transition: border-color 0.12s, color 0.12s, background 0.12s;
  letter-spacing: 0.01em;
}
.reaction-btn:hover { border-color: var(--color-accent); color: var(--color-accent); }
.reaction-btn.active { background: var(--color-accent); border-color: var(--color-accent); color: #fff; }
.reaction-btn:disabled { opacity: 0.55; cursor: not-allowed; }
.reaction-btn:disabled:hover { border-color: var(--color-border); color: var(--color-text-muted); }
.reaction-error { font-size: var(--text-xs); color: var(--color-danger); opacity: 0; transition: opacity 0.2s; margin-left: 0.25rem; }
.reaction-error.visible { opacity: 1; }

/* ── Comments ── */
.comments-section {
  margin-top: 2.5rem;
  padding-top: 2rem;
  border-top: 1px solid var(--color-border);
}
.comments-heading {
  font-family: var(--font-serif);
  font-size: var(--text-lg);
  font-weight: 600;
  color: var(--color-text);
  letter-spacing: -0.01em;
  margin-bottom: 1.25rem;
}
.comments-loading,
.comments-empty {
  color: var(--color-text-muted);
  font-style: italic;
  font-size: var(--text-sm);
  padding: 0.75rem 0;
}
.comments-error {
  color: #92400e;
  font-size: var(--text-sm);
  padding: 0.5rem 0;
}
.comment-error-msg {
  font-size: var(--text-xs);
  color: var(--color-danger);
  margin-top: 0.25rem;
}

#comments-list {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}
.comment {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: 8px;
  padding: 1rem 1.25rem;
}
.comment-meta {
  display: flex;
  gap: 0.5rem;
  align-items: baseline;
  margin-bottom: 0.5rem;
}
.comment-author {
  font-size: var(--text-sm);
  font-weight: 600;
  color: var(--color-text);
}
.comment-date {
  font-size: var(--text-xs);
  color: var(--color-text-muted);
}
.comment-body {
  font-family: var(--font-serif);
  font-size: var(--text-base);
  color: var(--color-text);
  line-height: 1.7;
  margin-bottom: 0.625rem;
  overflow-wrap: break-word;
  word-break: break-word;
}
.reply-btn {
  background: none;
  border: 1px solid var(--color-border);
  border-radius: 99px;
  padding: 0.2rem 0.625rem;
  font-family: var(--font-sans);
  font-size: var(--text-xs);
  font-weight: 500;
  color: var(--color-text-muted);
  cursor: pointer;
  transition: border-color 0.12s, color 0.12s;
}
.reply-btn:hover { border-color: var(--color-accent); color: var(--color-accent); }
.reply-btn:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; border-radius: 99px; }

.comment-replies {
  margin-top: 0.875rem;
  padding-top: 0.875rem;
  border-top: 1px solid var(--color-border);
  display: flex;
  flex-direction: column;
  gap: 0.625rem;
}
.comment-replies .comment {
  background: var(--color-bg);
}

/* Main comment form */
.comment-form:not(.reply-form) {
  margin-top: 1.75rem;
  padding-top: 1.5rem;
  border-top: 1px solid var(--color-border);
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}
.reply-form {
  margin-top: 1rem;
  padding: 0.875rem 1rem;
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: 6px;
  display: flex;
  flex-direction: column;
  gap: 0.625rem;
}
.comment-form textarea {
  width: 100%;
  border: 1px solid var(--color-border);
  border-radius: 6px;
  padding: 0.75rem 1rem;
  font-family: var(--font-sans);
  font-size: var(--text-sm);
  color: var(--color-text);
  background: var(--color-surface);
  resize: vertical;
  outline: none;
  transition: border-color 0.15s, box-shadow 0.15s;
  line-height: 1.5;
  min-height: 5rem;
}
.reply-form textarea { min-height: 4rem; resize: none; }
.comment-form textarea:focus {
  border-color: var(--color-accent);
  box-shadow: 0 0 0 3px var(--color-accent-ring);
}
.comment-submit {
  align-self: flex-start;
  background: var(--color-text);
  color: var(--color-surface);
  border: none;
  padding: 0.5rem 1.125rem;
  border-radius: 6px;
  font-family: var(--font-sans);
  font-size: var(--text-sm);
  font-weight: 500;
  cursor: pointer;
  transition: opacity 0.15s;
}
.comment-submit:hover { opacity: 0.85; }
.comment-submit:disabled { opacity: 0.5; cursor: not-allowed; }
.reply-form-actions { display: flex; gap: 0.5rem; justify-content: flex-end; }
.cancel-reply {
  background: none;
  border: 1px solid var(--color-border);
  padding: 0.5rem 1rem;
  border-radius: 6px;
  font-family: var(--font-sans);
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  cursor: pointer;
  transition: border-color 0.12s, color 0.12s;
}
.cancel-reply:hover { border-color: var(--color-text-2); color: var(--color-text); }

@media (prefers-reduced-motion: reduce) {
  .reaction-btn, .reply-btn, .cancel-reply,
  .comment-form textarea, .reaction-error, .delete-error { transition: none; }
}

.author-actions { display: flex; gap: 0.25rem; align-items: center; flex-shrink: 0; }
.action-link { font-size: var(--text-sm); color: var(--color-text-muted); text-decoration: none; padding: 0.25rem 0.375rem; margin: -0.25rem -0.375rem; }
.action-link:hover { color: var(--color-accent); }
.action-link:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 3px; border-radius: 2px; }
.action-sep { color: var(--color-border); font-size: var(--text-xs); user-select: none; padding: 0 0.125rem; }
.action-btn { background: none; border: none; cursor: pointer; font-size: var(--text-sm); padding: 0.25rem 0.375rem; margin: -0.25rem -0.375rem; font-family: var(--font-sans); }
.action-btn:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 3px; border-radius: 2px; }
.action-delete { color: var(--color-danger); }
.action-delete:hover { text-decoration: underline; }
.action-delete.armed { color: var(--color-danger-dark); text-decoration: underline; }
.action-delete:disabled { opacity: 0.55; cursor: not-allowed; text-decoration: none; }
.delete-error { font-size: var(--text-xs); color: var(--color-danger); opacity: 0; transition: opacity 0.2s; margin-left: 0.25rem; }
.delete-error.visible { opacity: 1; }
</style>
</head>

<body>

<!-- NAVBAR -->
<nav class="navbar">
  <a href="/dashboard" class="logo">LearnLog</a>
  <div class="nav-links">
    <a href="/dashboard">Dashboard</a>
    <a href="/posts/new">New Post</a>
    <a href="/profile">Profile</a>
    <button class="logout-btn" id="logout-btn">Logout</button>
  </div>
</nav>

<!-- POST -->
<article class="post-container">
  <a href="/dashboard" class="back-link">← Back to Dashboard</a>

  <header class="post-header">
    <h1 class="post-title">{post.title}</h1>
    {post.deck && <p class="post-deck">{post.deck}</p>}
    <div class="post-meta">
      <div class="post-meta-left">
        <span>{authorName}</span>
        <span class={`badge badge-${post.status}`}>{post.status}</span>
        {postDate && <span>{new Date(postDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>}
      </div>
      {isAuthor && (
        <div class="author-actions">
          <a href={`/posts/${post.slug}/edit`} class="action-link">Edit</a>
          <span class="action-sep" aria-hidden="true">·</span>
          <button id="delete-btn" class="action-btn action-delete" aria-label={`Delete "${post.title}"`}>Delete</button>
          <span id="delete-error" class="delete-error" aria-live="polite"></span>
        </div>
      )}
    </div>
    {Array.isArray(post.tags) && post.tags.length > 0 && (
      <div class="post-tags">
        {post.tags.map((tag: any) => (
          <span class="tag">{tag.name ?? tag}</span>
        ))}
      </div>
    )}
  </header>

  {bodyHtml && <div class="prose" set:html={bodyHtml} />}

  <!-- REACTIONS -->
  <div class="reaction-bar" id="reaction-bar"
    data-post-id={post.id}
    data-liked={String(userHasLiked)}
    data-disliked={String(userHasDisliked)}>
    <button class:list={['reaction-btn', userHasLiked && 'active']} id="like-btn"
      aria-label="Like this post" title="Like this post">
      ↑ <span id="like-count">{likeCount}</span>
    </button>
    <button class:list={['reaction-btn', userHasDisliked && 'active']} id="dislike-btn"
      aria-label="Dislike this post" title="Dislike this post">
      ↓ <span id="dislike-count">{dislikeCount}</span>
    </button>
    <span id="reaction-error" class="reaction-error" aria-live="polite"></span>
  </div>

  <!-- COMMENTS -->
  <section class="comments-section" id="comments-section"
    data-post-id={post.id}
    data-current-user-id={me.id}>
    <h2 class="comments-heading">Comments</h2>
    <div id="comments-list"><p class="comments-loading">Loading comments…</p></div>
    <form class="comment-form" id="comment-form">
      <textarea id="comment-body" placeholder="Leave a comment…" rows="3" required></textarea>
      <button type="submit" class="comment-submit">Post comment</button>
    </form>
  </section>
</article>

<script>
  import { fetchPayload } from '../../lib/payload';
  import { signOut } from '../../lib/auth';

  // ── Logout ──
  document.getElementById('logout-btn')!.addEventListener('click', async () => {
    await signOut();
    window.location.href = '/login';
  });

  // ── Reactions ──
  const bar = document.getElementById('reaction-bar')!;
  let liked    = bar.dataset.liked    === 'true';
  let disliked = bar.dataset.disliked === 'true';
  const postId = bar.dataset.postId!;

  // ── Delete ──
  const deleteBtn = document.getElementById('delete-btn') as HTMLButtonElement | null;
  if (deleteBtn) {
    const deleteError = document.getElementById('delete-error')!;
    let deleteArmed = false;
    let deleteResetTimer: ReturnType<typeof setTimeout> | null = null;

    function resetDelete() {
      deleteArmed = false;
      if (deleteResetTimer) clearTimeout(deleteResetTimer);
      deleteBtn!.textContent = 'Delete';
      deleteBtn!.classList.remove('armed');
      deleteBtn!.disabled = false;
    }

    deleteBtn.addEventListener('click', async () => {
      if (!deleteArmed) {
        deleteArmed = true;
        deleteBtn.textContent = 'Really delete?';
        deleteBtn.classList.add('armed');
        if (deleteResetTimer) clearTimeout(deleteResetTimer);
        deleteResetTimer = setTimeout(resetDelete, 4000);
        return;
      }

      if (deleteResetTimer) clearTimeout(deleteResetTimer);
      deleteBtn.disabled = true;
      deleteBtn.textContent = 'Deleting…';
      deleteBtn.classList.remove('armed');

      const token = localStorage.getItem('payload-token');
      const res = await fetch(`${import.meta.env.PUBLIC_PAYLOAD_URL}/api/posts/${postId}`, {
        method: 'DELETE',
        headers: { Authorization: `Bearer ${token}` },
      });

      if (res.ok) {
        window.location.href = '/dashboard';
      } else {
        resetDelete();
        deleteError.textContent = 'Could not delete — try again';
        deleteError.classList.add('visible');
        setTimeout(() => {
          deleteError.textContent = '';
          deleteError.classList.remove('visible');
        }, 4000);
      }
    });

    document.addEventListener('click', (e) => {
      if (deleteArmed && !deleteBtn.contains(e.target as Node)) resetDelete();
    });
  }

  const likeBtn        = document.getElementById('like-btn')!;
  const dislikeBtn     = document.getElementById('dislike-btn')!;
  const likeCountEl    = document.getElementById('like-count')!;
  const dislikeCountEl = document.getElementById('dislike-count')!;

  async function callReaction(field: 'like' | 'dislike', method: 'POST' | 'DELETE') {
    const data = await fetchPayload<{ likes: number; dislikes: number }>(
      `/posts/${postId}/${field}`, { method }
    );
    likeCountEl.textContent    = String(data.likes);
    dislikeCountEl.textContent = String(data.dislikes);
  }

  const reactionError = document.getElementById('reaction-error')!;
  let reactionErrorTimer: ReturnType<typeof setTimeout> | null = null;
  function showReactionError() {
    reactionError.textContent = 'Could not save — try again';
    reactionError.classList.add('visible');
    if (reactionErrorTimer) clearTimeout(reactionErrorTimer);
    reactionErrorTimer = setTimeout(() => reactionError.classList.remove('visible'), 3000);
  }

  let reactionInFlight = false;

  async function handleReaction(field: 'like' | 'dislike') {
    if (reactionInFlight) return;
    reactionInFlight = true;
    (likeBtn as HTMLButtonElement).disabled = true;
    (dislikeBtn as HTMLButtonElement).disabled = true;

    const prevLiked        = liked;
    const prevDisliked     = disliked;
    const prevLikeCount    = Number(likeCountEl.textContent);
    const prevDislikeCount = Number(dislikeCountEl.textContent);

    // Optimistic update
    if (field === 'like') {
      liked = !liked;
      if (liked) disliked = false;
    } else {
      disliked = !disliked;
      if (disliked) liked = false;
    }
    likeBtn.classList.toggle('active', liked);
    dislikeBtn.classList.toggle('active', disliked);
    likeCountEl.textContent    = String(prevLikeCount    + (liked    !== prevLiked    ? (liked    ? 1 : -1) : 0));
    dislikeCountEl.textContent = String(prevDislikeCount + (disliked !== prevDisliked ? (disliked ? 1 : -1) : 0));

    try {
      const wasActive = field === 'like' ? prevLiked : prevDisliked;
      await callReaction(field, wasActive ? 'DELETE' : 'POST');
    } catch {
      // Rollback to previous state
      liked    = prevLiked;
      disliked = prevDisliked;
      likeCountEl.textContent    = String(prevLikeCount);
      dislikeCountEl.textContent = String(prevDislikeCount);
      likeBtn.classList.toggle('active', liked);
      dislikeBtn.classList.toggle('active', disliked);
      showReactionError();
    } finally {
      reactionInFlight = false;
      (likeBtn as HTMLButtonElement).disabled = false;
      (dislikeBtn as HTMLButtonElement).disabled = false;
    }
  }

  likeBtn.addEventListener('click', () => handleReaction('like'));
  dislikeBtn.addEventListener('click', () => handleReaction('dislike'));

  // ── Comments ──
  const section = document.getElementById('comments-section')!;
  const commentPostId = Number(section.dataset.postId!);

  function escHtml(str: string): string {
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function timeAgo(dateStr: string): string {
    const diff = Date.now() - new Date(dateStr).getTime();
    const mins = Math.floor(diff / 60000);
    if (mins < 1)   return 'just now';
    if (mins < 60)  return `${mins}m ago`;
    const hours = Math.floor(mins / 60);
    if (hours < 24) return `${hours}h ago`;
    const days = Math.floor(hours / 24);
    if (days < 30)  return `${days}d ago`;
    return new Date(dateStr).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
  }

  function buildTree(flat: any[]): any[] {
    const map: Record<number, any> = {};
    const roots: any[] = [];
    for (const c of flat) map[c.id] = { ...c, replies: [] };
    for (const c of flat) {
      const parentId = c.parent?.id ?? c.parent;
      if (parentId && map[parentId]) map[parentId].replies.push(map[c.id]);
      else roots.push(map[c.id]);
    }
    return roots;
  }

  function buildCommentEl(c: any, depth: number): HTMLElement {
    const el = document.createElement('div');
    el.className = 'comment';

    const author = escHtml(c.author?.name ?? c.author?.email ?? 'Unknown');
    const body   = escHtml(c.body).replace(/\n/g, '<br>');

    el.innerHTML = `
      <div class="comment-meta">
        <span class="comment-author">${author}</span>
        <span class="comment-date">${timeAgo(c.createdAt)}</span>
      </div>
      <div class="comment-body">${body}</div>
      <button class="reply-btn">Reply</button>
    `;

    if (c.replies.length > 0) {
      const repliesEl = document.createElement('div');
      repliesEl.className = 'comment-replies';
      const nextDepth = Math.min(depth + 1, 4);
      for (const r of c.replies) repliesEl.appendChild(buildCommentEl(r, nextDepth));
      el.appendChild(repliesEl);
    }

    // Reply button
    (el.querySelector('.reply-btn') as HTMLButtonElement).addEventListener('click', () => {
      const existing = el.querySelector('.reply-form');
      if (existing) { existing.remove(); return; }

      const form = document.createElement('form');
      form.className = 'comment-form reply-form';
      form.innerHTML = `
        <textarea placeholder="Write a reply…" rows="2" required></textarea>
        <div class="reply-form-actions">
          <button type="submit" class="comment-submit">Reply</button>
          <button type="button" class="cancel-reply">Cancel</button>
        </div>
      `;
      form.querySelector('.cancel-reply')!.addEventListener('click', () => form.remove());
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const ta     = form.querySelector('textarea') as HTMLTextAreaElement;
        const body   = ta.value.trim();
        if (!body) return;
        const submit = form.querySelector('.comment-submit') as HTMLButtonElement;
        submit.disabled = true;
        try {
          await fetchPayload('/comments', {
            method:  'POST',
            headers: { 'Content-Type': 'application/json' },
            body:    JSON.stringify({ body, post: commentPostId, parent: c.id }),
          });
          await loadComments();
        } catch {
          submit.disabled = false;
          const errEl = document.createElement('p');
          errEl.className = 'comment-error-msg';
          errEl.textContent = 'Failed to post reply — please try again.';
          form.appendChild(errEl);
          setTimeout(() => errEl.remove(), 4000);
        }
      });

      const repliesEl = el.querySelector('.comment-replies');
      if (repliesEl) el.insertBefore(form, repliesEl);
      else el.appendChild(form);
      (form.querySelector('textarea') as HTMLTextAreaElement).focus();
    });

    return el;
  }

  async function loadComments() {
    const listEl = document.getElementById('comments-list')!;
    try {
      const data = await fetchPayload<{ docs: any[]; totalDocs: number }>(
        `/comments?where[post][equals]=${commentPostId}&depth=1&sort=createdAt&limit=100`
      );
      const tree = buildTree(data.docs);
      listEl.innerHTML = '';
      if (tree.length === 0) {
        listEl.innerHTML = '<p class="comments-empty">No comments yet.</p>';
      } else {
        for (const c of tree) listEl.appendChild(buildCommentEl(c, 0));
      }
      const heading = document.querySelector('.comments-heading')!;
      heading.textContent = `Comments${data.totalDocs > 0 ? ` (${data.totalDocs})` : ''}`;
    } catch {
      listEl.innerHTML = '<p class="comments-error">Could not load comments. Try refreshing the page.</p>';
    }
  }

  const commentForm   = document.getElementById('comment-form')   as HTMLFormElement;
  const commentBodyEl = document.getElementById('comment-body')   as HTMLTextAreaElement;
  const commentSubmit = commentForm.querySelector('.comment-submit') as HTMLButtonElement;

  commentForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const body = commentBodyEl.value.trim();
    if (!body) return;
    commentSubmit.disabled = true;
    commentSubmit.textContent = 'Posting…';
    const savedBody = commentBodyEl.value;
    commentBodyEl.value = '';
    try {
      await fetchPayload('/comments', {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ body, post: commentPostId }),
      });
      await loadComments();
    } catch {
      commentBodyEl.value = savedBody;
      const errEl = document.createElement('p');
      errEl.style.cssText = 'font-size:var(--text-xs);color:var(--color-danger);margin-top:0.25rem;';
      errEl.textContent = 'Failed to post comment — please try again.';
      commentForm.appendChild(errEl);
      setTimeout(() => errEl.remove(), 4000);
    } finally {
      commentSubmit.disabled = false;
      commentSubmit.textContent = 'Post comment';
    }
  });

  loadComments();
</script>

</body>
</html>
