---
import TagInput from '../../components/TagInput.astro';
import { toSlug } from '../../lib/tags';

const PAYLOAD_URL = import.meta.env.PUBLIC_PAYLOAD_URL ?? 'http://localhost:3000';
const cookie = Astro.request.headers.get('cookie') ?? '';

const authRes = await fetch(`${PAYLOAD_URL}/api/users/me`, { headers: { cookie } });
if (!authRes.ok) return Astro.redirect('/login');

// Server-side Payload helper — forwards the browser cookie, no client-side auth needed.
async function payloadFetch<T>(endpoint: string, init?: RequestInit): Promise<T> {
  const res = await fetch(`${PAYLOAD_URL}/api${endpoint}`, {
    ...init,
    headers: { 'Content-Type': 'application/json', Cookie: cookie, ...init?.headers },
  });
  const body = await res.json();
  if (!res.ok) {
    const reason =
      (Array.isArray(body?.errors) ? body.errors[0]?.message : null) ||
      body?.message ||
      res.statusText;
    throw new Error(`${res.status} ${reason}`);
  }
  return body as T;
}

const tagsRes = await fetch(`${PAYLOAD_URL}/api/tags`);
const tagsData = await tagsRes.json();

const availableTags = (tagsData.docs ?? []).map((tag: any) => ({
  id: tag.id,
  name: tag.name,
}));

function textToLexical(text: string) {
  const lines = text.split('\n').filter(l => l.trim().length > 0);
  const paragraphs = lines.length > 0
    ? lines.map(line => ({
        type: 'paragraph', version: 1, format: '', indent: 0, direction: 'ltr',
        children: [{ type: 'text', version: 1, detail: 0, format: 0, mode: 'normal', style: '', text: line.trim() }],
      }))
    : [{ type: 'paragraph', version: 1, format: '', indent: 0, direction: 'ltr', children: [] }];
  return { root: { type: 'root', version: 1, format: '', indent: 0, direction: 'ltr', children: paragraphs } };
}

let submitError = '';

if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData();
    const title = ((data.get('title') as string | null) ?? '').trim();
    const deck = ((data.get('deck') as string | null) ?? '').trim() || undefined;
    const status: 'draft' | 'published' =
      data.get('status') === 'published' ? 'published' : 'draft';
    const tagIds: number[] = JSON.parse(
        (data.get('selected-tags') as string | null) || '[]',
    );
    const bodyText = ((data.get('body') as string | null) ?? '').trim();
    const body = bodyText ? textToLexical(bodyText) : undefined;

    // Create post (with slug-conflict retry).
    type PostResponse = { doc: { id: number; slug: string } };
    const postBody = { title, deck, tags: tagIds, status, ...(body ? { body } : {}) };
    let createdSlug = '';
    try {
      const created = await payloadFetch<PostResponse>('/posts', {
        method: 'POST',
        body: JSON.stringify(postBody),
      });
      createdSlug = created.doc?.slug ?? '';
    } catch (err) {
      const msg = err instanceof Error ? err.message.toLowerCase() : '';
      const isSlugConflict =
        msg.includes('the following field is invalid: slug') ||
        (msg.includes('slug') &&
          (msg.includes('unique') || msg.includes('already exists') || msg.includes('duplicate')));
      if (!isSlugConflict) throw err;

      const created = await payloadFetch<PostResponse>('/posts', {
        method: 'POST',
        body: JSON.stringify({ ...postBody, slug: `${toSlug(title)}-${Date.now()}` }),
      });
      createdSlug = created.doc?.slug ?? '';
    }

    const redirectBase = status === 'published' ? 'created=1' : 'saved=1';
    const slugParam = createdSlug ? `&slug=${createdSlug}` : '';
    return Astro.redirect(`/dashboard?${redirectBase}${slugParam}`);
  } catch (err) {
    submitError = err instanceof Error ? err.message : 'Failed to create post. Please try again.';
  }
}
---

<html lang="en">
<head>
<meta charset="UTF-8" />
<title>New Post | LearnLog</title>

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;1,400&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&display=swap" rel="stylesheet" />

<style>
* { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --font-serif: 'Lora', Georgia, serif;
  --font-sans: 'DM Sans', system-ui, sans-serif;
  --color-bg: #f7f6f3;
  --color-surface: #ffffff;
  --color-border: #e4e2db;
  --color-text: #2d2d2d;
  --color-text-2: #5e6278;
  --color-text-muted: #9090a0;
  --color-accent:     #3d5a78;
  --text-xs: 0.6875rem;
  --text-sm: 0.8125rem;
}

body {
  font-family: var(--font-sans);
  margin: 0;
  background: var(--color-bg);
  color: var(--color-text);
}

.navbar {
  display: flex; justify-content: space-between; align-items: center;
  padding: 1.125rem 2.5rem;
  background: var(--color-surface);
  border-bottom: 1px solid var(--color-border);
}
.logo {
  font-family: var(--font-serif);
  font-size: 1.25rem;
  font-weight: 600;
  color: var(--color-text);
  text-decoration: none;
}
.nav-links { display: flex; align-items: center; }
.nav-links a {
  margin-left: 1.25rem;
  color: var(--color-text-2);
  font-size: 0.875rem;
  font-weight: 500;
  text-decoration: none;
  transition: color 0.12s;
}
.nav-links a:hover { color: var(--color-text); }
.nav-links a.active { color: var(--color-text); font-weight: 600; }
.logout-btn {
  margin-left: 1.25rem;
  background: transparent;
  color: var(--color-text-2);
  border: none;
  padding: 0.5rem 0;
  font-family: var(--font-sans);
  font-size: 0.875rem;
  font-weight: 500;
  cursor: pointer;
  transition: color 0.12s;
}
.logout-btn:hover { color: var(--color-text); }

.page {
  max-width: 42rem;
  margin: 3rem auto;
  padding: 0 1.5rem;
}
.page-label {
  font-size: var(--text-xs);
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--color-text-muted);
  margin-bottom: 1rem;
}
h1 {
  font-family: var(--font-serif);
  font-size: 1.75rem;
  font-weight: 600;
  letter-spacing: -0.025em;
  line-height: 1.15;
  margin-bottom: 0.4rem;
}
.subtitle {
  font-size: 0.9375rem;
  color: var(--color-text-2);
  margin-bottom: 2.5rem;
}

form {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: 10px;
  padding: 2rem;
  display: grid;
  gap: 1.25rem;
}
label {
  display: grid;
  gap: 0.4rem;
  font-size: 0.9rem;
}
input, textarea, select {
  border: 1px solid var(--color-border);
  border-radius: 8px;
  padding: 0.65rem 0.75rem;
  font: inherit;
  color: var(--color-text);
  background: #fff;
}
textarea { resize: vertical; min-height: 88px; }
#post-body { font-family: var(--font-serif); line-height: 1.75; min-height: 15rem; }

.actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 0.75rem;
}
.button {
  background: #2d2d2d;
  color: #fff;
  border: none;
  border-radius: 6px;
  padding: 0.6rem 1rem;
  cursor: pointer;
}
.button.secondary {
  background: #6b7280;
}
.button-row {
  display: flex;
  gap: 0.6rem;
}
.message {
  font-size: 0.9rem;
  color: var(--color-text-2);
}
.error { color: #b91c1c; }
.cancel-link {
  font-size: 0.875rem;
  color: var(--color-text-muted);
  text-decoration: none;
  transition: color 0.12s;
}
.cancel-link:hover { color: var(--color-text-2); }
</style>
</head>

<body>
<nav class="navbar">
  <a href="/dashboard" class="logo">LearnLog</a>
  <div class="nav-links">
    <a href="/dashboard">Dashboard</a>
    <a href="/posts/new" class="active">New Post</a>
    <a href="/profile">Profile</a>
    <button class="logout-btn" id="logout-btn">Logout</button>
  </div>
</nav>

<main class="page">
  <p class="page-label">New entry</p>
  <h1>Create a Post</h1>
  <p class="subtitle">Share what you learned today.</p>

  <form method="POST">
    <label>
      Title
      <input name="title" type="text" required placeholder="What did you learn today?" maxlength="120" />
    </label>

    <label>
      Summary
      <textarea name="deck" placeholder="One sentence — appears below your title in post cards" maxlength="400"></textarea>
      <span style="font-size:0.75rem; color:var(--color-text-muted);">Shown below your title when browsing posts.</span>
    </label>

    <label>
      Content
      <textarea name="body" id="post-body" placeholder="Write your learning log here…"></textarea>
    </label>

    <TagInput
        hiddenInputId="selected-tags"
        inputId="post-tag-input"
        availableTags={availableTags}
    />

    <div class="actions">
      {submitError && <p class="message error">{submitError}</p>}
      <div style="display:flex; align-items:center; gap:1.25rem;">
        <a href="/dashboard" class="cancel-link">Cancel</a>
        <div class="button-row">
          <button class="button secondary" type="submit" name="status" value="draft">Save draft</button>
          <button class="button" type="submit" name="status" value="published">Publish</button>
        </div>
      </div>
    </div>
  </form>
</main>

<script>
  import { signOut } from '../../lib/auth';

  document.getElementById('logout-btn')!.addEventListener('click', async () => {
    await signOut();
    window.location.href = '/login';
  });

  const DRAFT_KEY = 'learnlog-draft';
  const titleInput = document.querySelector('input[name="title"]') as HTMLInputElement | null;
  const deckInput  = document.querySelector('textarea[name="deck"]') as HTMLTextAreaElement | null;
  const bodyInput  = document.getElementById('post-body') as HTMLTextAreaElement | null;

  // Silently restore draft on load if form is empty
  try {
    const raw = localStorage.getItem(DRAFT_KEY);
    if (raw && titleInput && !titleInput.value) {
      const { title, deck, body } = JSON.parse(raw) as { title: string; deck: string; body: string };
      if (title) titleInput.value = title;
      if (deck && deckInput && !deckInput.value) deckInput.value = deck;
      if (body && bodyInput && !bodyInput.value) bodyInput.value = body;
    }
  } catch {}

  // Autosave on input
  function autosave() {
    const title = titleInput?.value ?? '';
    const deck  = deckInput?.value  ?? '';
    const body  = bodyInput?.value  ?? '';
    if (title || deck || body) {
      localStorage.setItem(DRAFT_KEY, JSON.stringify({ title, deck, body }));
    } else {
      localStorage.removeItem(DRAFT_KEY);
    }
  }
  titleInput?.addEventListener('input', autosave);
  deckInput?.addEventListener('input',  autosave);
  bodyInput?.addEventListener('input',  autosave);
</script>

</body>
</html>
