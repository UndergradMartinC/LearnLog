---
import TagInput from '../../components/TagInput.astro';
import { toSlug } from '../../lib/tags';

const PAYLOAD_URL = import.meta.env.PUBLIC_PAYLOAD_URL ?? 'http://localhost:3000';
const cookie = Astro.request.headers.get('cookie') ?? '';

const authRes = await fetch(`${PAYLOAD_URL}/api/users/me`, { headers: { cookie } });
if (!authRes.ok) return Astro.redirect('/login');

// Server-side Payload helper — forwards the browser cookie, no client-side auth needed.
async function payloadFetch<T>(endpoint: string, init?: RequestInit): Promise<T> {
  const res = await fetch(`${PAYLOAD_URL}/api${endpoint}`, {
    ...init,
    headers: { 'Content-Type': 'application/json', Cookie: cookie, ...init?.headers },
  });
  const body = await res.json();
  if (!res.ok) {
    const reason =
      (Array.isArray(body?.errors) ? body.errors[0]?.message : null) ||
      body?.message ||
      res.statusText;
    throw new Error(`${res.status} ${reason}`);
  }
  return body as T;
}

let submitError = '';

if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData();
    const title = ((data.get('title') as string | null) ?? '').trim();
    const deck = ((data.get('deck') as string | null) ?? '').trim() || undefined;
    const status: 'draft' | 'published' =
      data.get('status') === 'published' ? 'published' : 'draft';
    const tagNames: string[] = JSON.parse(
      (data.get('selected-tags') as string | null) || '[]',
    );

    // Resolve tags: find existing by slug, create if missing.
    type TagDoc = { id: number; name: string; slug: string };
    type TagsResponse = { docs?: TagDoc[] };
    const tagIds: number[] = [];

    for (const name of [...new Set(tagNames.map((n) => n.trim()).filter(Boolean))]) {
      const slug = toSlug(name);
      if (!slug) continue;

      let tag: TagDoc | null = null;
      const found = await payloadFetch<TagsResponse>(
        `/tags?where[slug][equals]=${encodeURIComponent(slug)}&limit=1`,
      );
      tag = found.docs?.[0] ?? null;

      if (!tag) {
        try {
          tag = await payloadFetch<TagDoc>('/tags', {
            method: 'POST',
            body: JSON.stringify({ name, slug }),
          });
        } catch {
          // Race condition: another request created the same slug first.
          const retry = await payloadFetch<TagsResponse>(
            `/tags?where[slug][equals]=${encodeURIComponent(slug)}&limit=1`,
          );
          tag = retry.docs?.[0] ?? null;
        }
      }

      if (tag) tagIds.push(tag.id);
    }

    // Create post (with slug-conflict retry).
    type PostResponse = { doc: { id: number; slug: string } };
    const postBody = { title, deck, tags: tagIds, status };
    try {
      await payloadFetch<PostResponse>('/posts', {
        method: 'POST',
        body: JSON.stringify(postBody),
      });
    } catch (err) {
      const msg = err instanceof Error ? err.message.toLowerCase() : '';
      const isSlugConflict =
        msg.includes('slug') &&
        (msg.includes('unique') || msg.includes('already exists') || msg.includes('duplicate'));
      if (!isSlugConflict) throw err;

      await payloadFetch<PostResponse>('/posts', {
        method: 'POST',
        body: JSON.stringify({ ...postBody, slug: `${toSlug(title)}-${Date.now()}` }),
      });
    }

    return Astro.redirect(`/dashboard?${status === 'published' ? 'created=1' : 'saved=1'}`);
  } catch (err) {
    submitError = err instanceof Error ? err.message : 'Failed to create post. Please try again.';
  }
}
---

<html lang="en">
<head>
<meta charset="UTF-8" />
<title>New Post | LearnLog</title>

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;1,400&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&display=swap" rel="stylesheet" />

<style>
* { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --font-serif: 'Lora', Georgia, serif;
  --font-sans: 'DM Sans', system-ui, sans-serif;
  --color-bg: #f7f6f3;
  --color-surface: #ffffff;
  --color-border: #e4e2db;
  --color-text: #2d2d2d;
  --color-text-2: #5e6278;
  --color-text-muted: #9090a0;
  --color-accent:     #3d5a78;
  --text-xs: 0.6875rem;
  --text-sm: 0.8125rem;
}

body {
  font-family: var(--font-sans);
  margin: 0;
  background: var(--color-bg);
  color: var(--color-text);
}

.navbar {
  display: flex; justify-content: space-between; align-items: center;
  padding: 1.125rem 2.5rem;
  background: var(--color-surface);
  border-bottom: 1px solid var(--color-border);
}
.logo {
  font-family: var(--font-serif);
  font-size: 1.25rem;
  font-weight: 600;
  color: var(--color-text);
  text-decoration: none;
}
.nav-links a {
  margin-left: 1.25rem;
  color: var(--color-text-2);
  font-size: 0.875rem;
  font-weight: 500;
  text-decoration: none;
}
.logout-btn {
  margin-left: 1.25rem;
  background: transparent;
  color: var(--color-text-2);
  border: none;
  padding: 0.5rem 0;
  font-family: var(--font-sans);
  font-size: 0.875rem;
  font-weight: 500;
  cursor: pointer;
  transition: color 0.12s;
}
.logout-btn:hover { color: var(--color-text); }

.page {
  max-width: 42rem;
  margin: 2.5rem auto;
  padding: 0 1.5rem;
}
h1 {
  font-family: var(--font-serif);
  margin-bottom: 0.75rem;
}
.subtitle {
  color: var(--color-text-2);
  margin-bottom: 1.5rem;
}

form {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: 10px;
  padding: 1.25rem;
  display: grid;
  gap: 1rem;
}
label {
  display: grid;
  gap: 0.4rem;
  font-size: 0.9rem;
}
input, textarea, select {
  border: 1px solid var(--color-border);
  border-radius: 8px;
  padding: 0.65rem 0.75rem;
  font: inherit;
  color: var(--color-text);
  background: #fff;
}
textarea { resize: vertical; min-height: 88px; }

.actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 0.75rem;
}
.button {
  background: #2d2d2d;
  color: #fff;
  border: none;
  border-radius: 6px;
  padding: 0.6rem 1rem;
  cursor: pointer;
}
.button.secondary {
  background: #6b7280;
}
.button-row {
  display: flex;
  gap: 0.6rem;
}
.message {
  font-size: 0.9rem;
  color: var(--color-text-2);
}
.error { color: #b91c1c; }
</style>
</head>

<body>
<nav class="navbar">
  <a href="/dashboard" class="logo">LearnLog</a>
  <div class="nav-links">
    <a href="/dashboard">Dashboard</a>
    <a href="/profile">Profile</a>
    <button class="logout-btn" id="logout-btn">Logout</button>
  </div>
</nav>

<main class="page">
  <h1>Create a Post</h1>
  <p class="subtitle">Share what you learned today.</p>

  <form method="POST">
    <label>
      Title
      <input name="title" type="text" required placeholder="What did you learn today?" />
    </label>

    <label>
      Description
      <textarea name="deck" placeholder="Explain what you learned..."></textarea>
    </label>

    <TagInput hiddenInputId="selected-tags" inputId="post-tag-input" />

    <div class="actions">
      {submitError && <p class="message error">{submitError}</p>}
      <div class="button-row">
        <button class="button secondary" type="submit" name="status" value="draft">Save draft</button>
        <button class="button" type="submit" name="status" value="published">Publish</button>
      </div>
    </div>
  </form>
</main>

<script>
  import { signOut } from '../../lib/auth';

  document.getElementById('logout-btn')!.addEventListener('click', async () => {
    await signOut();
    window.location.href = '/login';
  });

  const DRAFT_KEY = 'learnlog-draft';
  const titleInput = document.querySelector('input[name="title"]') as HTMLInputElement | null;
  const deckInput  = document.querySelector('textarea[name="deck"]') as HTMLTextAreaElement | null;

  // Silently restore draft on load if form is empty
  try {
    const raw = localStorage.getItem(DRAFT_KEY);
    if (raw && titleInput && !titleInput.value) {
      const { title, deck } = JSON.parse(raw) as { title: string; deck: string };
      if (title) titleInput.value = title;
      if (deck && deckInput && !deckInput.value) deckInput.value = deck;
    }
  } catch {}

  // Autosave on input
  function autosave() {
    const title = titleInput?.value ?? '';
    const deck  = deckInput?.value  ?? '';
    if (title || deck) {
      localStorage.setItem(DRAFT_KEY, JSON.stringify({ title, deck }));
    } else {
      localStorage.removeItem(DRAFT_KEY);
    }
  }
  titleInput?.addEventListener('input', autosave);
  deckInput?.addEventListener('input',  autosave);
</script>

</body>
</html>
