---
export const prerender = true;
const title = "Reset password | LearnLog";
---

<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;1,400&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&display=swap" rel="stylesheet" />
<link rel="icon" type="image/png" href="/favicon-32x32.png" />
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --font-serif: 'Lora', Georgia, serif;
  --font-sans:  'DM Sans', system-ui, sans-serif;
  --color-bg:         #f7f6f3;
  --color-surface:    #ffffff;
  --color-border:     #e4e2db;
  --color-text:       #2d2d2d;
  --color-text-2:     #5e6278;
  --color-text-muted: #9090a0;
  --color-accent:     #3d5a78;
  --color-panel:      #22222e;
}

body {
  font-family: var(--font-sans);
  background: var(--color-bg);
  color: var(--color-text);
  -webkit-font-smoothing: antialiased;
}

/* ─── NAVBAR ─── */
.navbar {
  padding: 1.125rem 2.5rem;
  background: var(--color-surface);
  border-bottom: 1px solid var(--color-border);
}
.logo {
  font-family: var(--font-serif);
  font-size: 1.25rem;
  font-weight: 600;
  color: var(--color-text);
  letter-spacing: -0.01em;
  text-decoration: none;
}

/* ─── SPLIT LAYOUT ─── */
.auth-layout {
  display: flex;
  min-height: calc(100vh - 61px);
}
.form-side {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 3rem 2rem;
  background: var(--color-surface);
}
.form-inner {
  width: 100%;
  max-width: 22rem;
}
.panel-side {
  flex: 1;
  background: var(--color-panel);
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 4rem;
}

/* ─── FORM ─── */
.form-heading {
  font-family: var(--font-serif);
  font-size: 1.875rem;
  font-weight: 600;
  letter-spacing: -0.025em;
  color: var(--color-text);
  margin-bottom: 0.3rem;
  line-height: 1.15;
}
.form-subheading {
  font-size: 0.875rem;
  color: var(--color-text-muted);
  margin-bottom: 2rem;
  line-height: 1.5;
}
.field { margin-bottom: 1.125rem; }
label {
  display: block;
  font-size: 0.8125rem;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 0.35rem;
}
input {
  width: 100%;
  padding: 0.625rem 0.75rem;
  border: 1px solid var(--color-border);
  border-radius: 6px;
  font-size: 1rem;
  font-family: var(--font-sans);
  color: var(--color-text);
  background: var(--color-bg);
  transition: border-color 0.15s, box-shadow 0.15s;
}
input:focus {
  outline: none;
  border-color: var(--color-accent);
  box-shadow: 0 0 0 3px rgba(61, 90, 120, 0.12);
}
.error-msg {
  font-size: 0.8125rem;
  color: #b91c1c;
  min-height: 1.125rem;
  margin-bottom: 0.875rem;
}
.submit-btn {
  width: 100%;
  padding: 0.7rem;
  background: var(--color-text);
  color: white;
  border: none;
  border-radius: 6px;
  font-family: var(--font-sans);
  font-size: 0.9375rem;
  font-weight: 600;
  cursor: pointer;
  transition: opacity 0.12s;
  margin-bottom: 1.25rem;
  letter-spacing: 0.01em;
}
.submit-btn:hover:not(:disabled) { opacity: 0.8; }
.submit-btn:disabled { opacity: 0.5; cursor: not-allowed; }

/* ─── SUCCESS STATE ─── */
.success-state { display: none; }
.success-state.visible { display: block; }
.success-icon {
  width: 2.5rem;
  height: 2.5rem;
  border-radius: 50%;
  background: #ecfdf5;
  border: 1px solid #c8e6d8;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 1.25rem;
  font-size: 1rem;
}
.success-heading {
  font-family: var(--font-serif);
  font-size: 1.5rem;
  font-weight: 600;
  letter-spacing: -0.02em;
  color: var(--color-text);
  margin-bottom: 0.5rem;
  line-height: 1.2;
}
.success-body {
  font-size: 0.9rem;
  color: var(--color-text-2);
  line-height: 1.65;
  margin-bottom: 1.75rem;
}

.switch-text { font-size: 0.875rem; color: var(--color-text-2); }
.switch-text a {
  color: var(--color-accent);
  font-weight: 600;
  text-decoration: none;
}
.switch-text a:hover { text-decoration: underline; }

/* ─── PANEL ─── */
.panel-brand {
  font-family: var(--font-serif);
  font-size: 0.875rem;
  font-weight: 600;
  color: #5a5a72;
  margin-bottom: 2.5rem;
  letter-spacing: 0.01em;
}
.panel-quote {
  font-family: var(--font-serif);
  font-size: clamp(1.375rem, 2vw, 2rem);
  font-weight: 600;
  line-height: 1.25;
  letter-spacing: -0.025em;
  color: #eae7e0;
  margin-bottom: 1.5rem;
  max-width: 22ch;
}
.panel-body {
  font-size: 0.9375rem;
  color: #5a5a72;
  line-height: 1.7;
  max-width: 34ch;
}

@media (max-width: 768px) {
  .panel-side { display: none; }
  .form-side { padding: 2.5rem 1.5rem; align-items: flex-start; padding-top: 3rem; }
}
</style>
</head>

<body>

<nav class="navbar">
  <a href="/" class="logo">LearnLog</a>
</nav>

<div class="auth-layout">

  <!-- FORM SIDE -->
  <div class="form-side">
    <div class="form-inner">

      <!-- Request form -->
      <div id="request-form-wrap">
        <h1 class="form-heading">Reset your password.</h1>
        <p class="form-subheading">Enter your email and we'll send you a link to create a new password.</p>

        <form id="reset-form">
          <div class="field">
            <label for="email">Email</label>
            <input type="email" id="email" placeholder="you@university.edu" required autocomplete="email" />
          </div>
          <p class="error-msg" id="error-msg" role="alert"></p>
          <button class="submit-btn" id="submit-btn" type="submit">Send reset link</button>
        </form>

        <p class="switch-text"><a href="/login">← Back to sign in</a></p>
      </div>

      <!-- Success state -->
      <div class="success-state" id="success-state">
        <div class="success-icon">✓</div>
        <h2 class="success-heading">Check your inbox.</h2>
        <p class="success-body" id="success-body">
          We sent a password reset link to your email address.
          The link expires in 1 hour.
        </p>
        <p class="switch-text"><a href="/login">← Back to sign in</a></p>
      </div>

    </div>
  </div>

  <!-- PANEL SIDE -->
  <div class="panel-side">
    <p class="panel-brand">LearnLog</p>
    <p class="panel-quote">Forgetting is human. Your logs aren't going anywhere.</p>
    <p class="panel-body">
      Reset your password and get back to documenting what you learn.
    </p>
  </div>

</div>

<script>
  const form        = document.getElementById('reset-form')       as HTMLFormElement;
  const btn         = document.getElementById('submit-btn')       as HTMLButtonElement;
  const errorMsg    = document.getElementById('error-msg')        as HTMLElement;
  const formWrap    = document.getElementById('request-form-wrap') as HTMLElement;
  const successState = document.getElementById('success-state')   as HTMLElement;
  const successBody  = document.getElementById('success-body')    as HTMLElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorMsg.textContent = '';
    btn.disabled = true;
    btn.textContent = 'Sending…';

    const email = (document.getElementById('email') as HTMLInputElement).value.trim();

    try {
      const res = await fetch(
        `${import.meta.env.PUBLIC_PAYLOAD_URL ?? 'http://localhost:3000'}/api/users/forgot-password`,
        {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email }),
        }
      );

      if (!res.ok && res.status !== 404) {
        // Payload returns 200 even for unknown emails (security best practice).
        // Treat any non-200 (except 404 which some setups return) as error.
        throw new Error('Something went wrong. Please try again.');
      }

      // Always show success to prevent email enumeration
      successBody.textContent = `We sent a reset link to ${email}. The link expires in 1 hour.`;
      formWrap.style.display = 'none';
      successState.classList.add('visible');
    } catch (err: any) {
      errorMsg.textContent = err?.message ?? 'Something went wrong. Please try again.';
      btn.disabled = false;
      btn.textContent = 'Send reset link';
    }
  });
</script>

</body>
</html>
