---
const PAYLOAD_URL = import.meta.env.PUBLIC_PAYLOAD_URL ?? 'http://localhost:3000';
const cookie = Astro.request.headers.get('cookie') ?? '';

const meRes = await fetch(`${PAYLOAD_URL}/api/users/me`, { headers: { cookie } });
if (!meRes.ok) return Astro.redirect('/login');
const { user } = await meRes.json();

const postsRes = await fetch(
  `${PAYLOAD_URL}/api/posts?where[author][equals]=${user.id}&sort=-createdAt&limit=5&depth=0`,
  { headers: { cookie } }
);
const postsData = postsRes.ok ? await postsRes.json() : { docs: [] };
const posts: any[] = postsData.docs ?? [];

const displayName: string = user.name ?? user.email ?? '?';
const initial: string = displayName[0].toUpperCase();
const title = `${user.name ? user.name + ' — ' : ''}LearnLog`;
---

<html lang="en">
<head>
<meta charset="UTF-8" />
<title>{title}</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;1,400&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&display=swap" rel="stylesheet" />

<style>
* { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --font-serif: 'Lora', Georgia, serif;
  --font-sans:  'DM Sans', system-ui, sans-serif;
  --text-xs:    0.6875rem;
  --text-sm:    0.8125rem;
  --text-base:  1rem;
  --text-lg:    1.125rem;
  --text-xl:    1.75rem;
  --color-bg:         #f7f6f3;
  --color-surface:    #ffffff;
  --color-border:     #e4e2db;
  --color-text:       #2d2d2d;
  --color-text-2:     #5e6278;
  --color-text-muted: #9090a0;
  --color-accent:     #3d5a78;
}

body {
  font-family: var(--font-sans);
  background: var(--color-bg);
  color: var(--color-text);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

/* ─── NAVBAR ─── */
.navbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1.125rem 2.5rem;
  background: var(--color-surface);
  border-bottom: 1px solid var(--color-border);
}
.logo {
  font-family: var(--font-serif);
  font-size: 1.25rem;
  font-weight: 600;
  color: var(--color-text);
  letter-spacing: -0.01em;
  text-decoration: none;
}
.nav-links { display: flex; align-items: center; }
.nav-links a {
  margin-left: 1.25rem;
  color: var(--color-text-2);
  font-size: var(--text-sm);
  font-weight: 500;
  text-decoration: none;
  transition: color 0.12s;
}
.nav-links a:hover { color: var(--color-text); }
.nav-links a.active { color: var(--color-text); font-weight: 600; }
.logout-btn {
  margin-left: 1.25rem;
  background: var(--color-text);
  color: var(--color-surface);
  border: none;
  padding: 0.5rem 1rem;
  border-radius: 6px;
  font-family: var(--font-sans);
  font-size: var(--text-sm);
  font-weight: 500;
  cursor: pointer;
  transition: opacity 0.12s;
}
.logout-btn:hover { opacity: 0.8; }

/* ─── PROFILE HEADER ─── */
.profile-header {
  background: var(--color-surface);
  border-bottom: 1px solid var(--color-border);
  padding: 3rem 2.5rem 2.25rem;
}
.profile-header-inner {
  max-width: 52rem;
  margin: 0 auto;
  display: flex;
  align-items: flex-start;
  gap: 1.75rem;
}
.avatar {
  flex-shrink: 0;
  width: 76px;
  height: 76px;
  border-radius: 50%;
  background: var(--color-accent);
  color: #fff;
  font-family: var(--font-serif);
  font-size: 2rem;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: -0.02em;
  user-select: none;
}
.profile-info { flex: 1; min-width: 0; }
.profile-name {
  font-family: var(--font-serif);
  font-size: 2.5rem;
  font-weight: 600;
  letter-spacing: -0.03em;
  line-height: 1.1;
  color: var(--color-text);
  margin-bottom: 0.2rem;
}
.profile-email {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  margin-bottom: 0.85rem;
}
.profile-meta {
  display: flex;
  gap: 1.5rem;
  flex-wrap: wrap;
  margin-bottom: 1rem;
}
.meta-item {
  display: flex;
  gap: 0.35rem;
  align-items: baseline;
  font-size: var(--text-sm);
  color: var(--color-text-2);
}
.meta-label {
  font-size: var(--text-xs);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.07em;
  color: var(--color-text-muted);
}
.edit-link {
  display: inline-block;
  font-size: var(--text-sm);
  font-weight: 500;
  color: var(--color-accent);
  text-decoration: none;
  border: 1px solid var(--color-accent);
  padding: 0.3rem 0.75rem;
  border-radius: 5px;
  transition: background 0.14s, color 0.14s;
  letter-spacing: 0.01em;
}
.edit-link:hover { background: var(--color-accent); color: #fff; }

/* ─── CONTENT ─── */
.content {
  max-width: 52rem;
  margin: 0 auto;
  padding: 2.5rem 2.5rem 4rem;
}
.section + .section { margin-top: 2.75rem; }

.section-label {
  font-size: var(--text-xs);
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--color-text-muted);
  margin-bottom: 1rem;
  padding-bottom: 0.5rem;
  border-bottom: 1px solid var(--color-border);
}

.bio-text {
  font-family: var(--font-serif);
  font-size: 1.05rem;
  font-style: italic;
  line-height: 1.8;
  color: var(--color-text);
}
.bio-empty {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  font-style: italic;
}
.bio-empty a { color: var(--color-accent); text-decoration: none; }
.bio-empty a:hover { text-decoration: underline; }

/* ─── POSTS LIST ─── */
.posts-list { display: flex; flex-direction: column; }
.post-item {
  display: block;
  text-decoration: none;
  color: inherit;
  padding: 1.1rem 0;
  border-bottom: 1px solid var(--color-border);
  transition: opacity 0.1s;
}
.post-item:first-child { border-top: 1px solid var(--color-border); }
.post-item:hover .post-title { color: var(--color-accent); }
.post-title {
  font-family: var(--font-serif);
  font-size: var(--text-lg);
  font-weight: 600;
  letter-spacing: -0.01em;
  color: var(--color-text);
  transition: color 0.12s;
  margin-bottom: 0.15rem;
}
.post-deck {
  font-size: var(--text-sm);
  color: var(--color-text-2);
  line-height: 1.55;
}
.empty-state {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  font-style: italic;
}
.empty-state a { color: var(--color-accent); text-decoration: none; }
.empty-state a:hover { text-decoration: underline; }
</style>
</head>

<body>

<nav class="navbar">
  <a href="/dashboard" class="logo">LearnLog</a>
  <div class="nav-links">
    <a href="/dashboard">Dashboard</a>
    <a href="/posts/new">New Post</a>
    <a href="/profile" class="active">Profile</a>
    <button class="logout-btn" id="logout-btn">Logout</button>
  </div>
</nav>

<div class="profile-header">
  <div class="profile-header-inner">
    <div class="avatar" aria-hidden="true">{initial}</div>
    <div class="profile-info">
      <div class="profile-name">{displayName}</div>
      {user.name && <div class="profile-email">{user.email}</div>}
      {(user.major || user.school) && (
        <div class="profile-meta">
          {user.major && (
            <span class="meta-item">
              <span class="meta-label">Major</span>
              <span>{user.major}</span>
            </span>
          )}
          {user.school && (
            <span class="meta-item">
              <span class="meta-label">School</span>
              <span>{user.school}</span>
            </span>
          )}
        </div>
      )}
      <a href="/profile/edit" class="edit-link">Edit profile</a>
    </div>
  </div>
</div>

<div class="content">

  <div class="section">
    <div class="section-label">About</div>
    {user.bio
      ? <p class="bio-text">{user.bio}</p>
      : <p class="bio-empty">No bio yet. <a href="/profile/edit">Add one →</a></p>
    }
  </div>

  <div class="section">
    <div class="section-label">Learning Logs</div>
    {posts.length > 0 ? (
      <div class="posts-list">
        {posts.map((post: any) => (
          <a href={`/posts/${post.slug}`} class="post-item">
            <div class="post-title">{post.title}</div>
            {post.deck && <div class="post-deck">{post.deck}</div>}
          </a>
        ))}
      </div>
    ) : (
      <p class="empty-state">No learning logs yet. <a href="/posts/new">Write your first one →</a></p>
    )}
  </div>

</div>

<script>
import { signOut } from '../lib/auth';
document.getElementById('logout-btn')!.addEventListener('click', async () => {
  await signOut();
  window.location.href = '/login';
});
</script>

</body>
</html>
