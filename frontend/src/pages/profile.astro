---
const PAYLOAD_URL = import.meta.env.PUBLIC_PAYLOAD_URL ?? 'http://localhost:3000';
const cookie = Astro.request.headers.get('cookie') ?? '';

const meRes = await fetch(`${PAYLOAD_URL}/api/users/me`, { headers: { cookie } });
if (!meRes.ok) return Astro.redirect('/login');

const { user } = await meRes.json();

const postsRes = await fetch(
  `${PAYLOAD_URL}/api/posts?where[author][equals]=${user.id}&depth=0`,
  { headers: { cookie } }
);
const postsData = postsRes.ok ? await postsRes.json() : { docs: [] };
const posts: any[] = postsData.docs ?? [];

const title = "Profile - LearnLog";
---

<html>
<head>
<meta charset="UTF-8">
<title>{title}</title>

<style>
body {
  margin: 0;
  font-family: Arial;
  background: #f5f5f5;
}

/* ================= NAVBAR ================= */
.navbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15px 40px;
  background: white;
  border-bottom: 1px solid #eee;
}

.logo {
  font-weight: bold;
  font-size: 18px;
  color: #2563eb;
}

.nav-right {
  display: flex;
  align-items: center;
  gap: 25px;
}

.nav-right a {
  text-decoration: none;
  color: #333;
  font-size: 14px;
}

.nav-right a:hover {
  color: #7c3aed;
}

.nav-profile {
  display: flex;
  align-items: center;
  gap: 10px;
}

.nav-avatar {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  overflow: hidden;
  border: 2px solid #7c3aed;
  background: #e5e7eb;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #7c3aed;
  font-weight: bold;
  font-size: 14px;
}

/* ================= COVER ================= */
.cover {
  height: 260px;
  background: linear-gradient(90deg, #2563eb, #7c3aed);
  display: flex;
  justify-content: flex-end;
  align-items: center;
  padding: 0 60px;
  color: white;
}

.profile-row {
  display: flex;
  align-items: center;
  gap: 20px;
}

.name-section {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.name {
  font-size: 32px;
  font-weight: bold;
}

/* ================= BUTTON ================= */
.edit-btn, .save-btn {
  margin-top: 10px;
  padding: 10px 20px;
  border-radius: 999px;
  border: none;
  font-weight: bold;
  cursor: pointer;
  transition: 0.2s;
}

.edit-btn {
  background: linear-gradient(135deg, #4ade80, #22c55e);
  color: white;
}

.save-btn {
  background: linear-gradient(135deg, #22c55e, #15803d);
  color: white;
}

/* ================= AVATAR ================= */
.avatar {
  width: 110px;
  height: 110px;
  border-radius: 50%;
  border: 4px solid white;
  overflow: hidden;
  background: #e5e7eb;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #7c3aed;
  font-weight: bold;
  font-size: 36px;
}

/* ================= MAIN ================= */
.container {
  padding: 40px;
}

.section-title {
  text-align: center;
}

.cards {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  margin-top: 30px;
}

.card {
  background: #e5e7eb;
  padding: 20px;
  border-radius: 10px;
}

.card strong {
  display: block;
  text-align: center;
  margin-bottom: 8px;
}

.card p {
  text-align: center;
}

.empty-state {
  text-align: center;
  color: #9ca3af;
  margin-top: 30px;
  font-size: 14px;
}

input, textarea {
  width: 100%;
  padding: 6px;
  box-sizing: border-box;
}
</style>
</head>

<body>

<div
  id="profileData"
  data-id={user.id}
  data-name={user.name ?? ''}
  data-bio={user.bio ?? ''}
  data-major={user.major ?? ''}
  data-school={user.school ?? ''}
  style="display:none"
></div>

<div class="navbar">
  <div class="logo">LearnLog</div>

  <div class="nav-right">
    <a href="/dashboard">Dashboard</a>
    <a href="/posts/new">New Post</a>

    <div class="nav-profile">
      <span id="navName">{user.name ?? user.email}</span>
      <div class="nav-avatar">{(user.name ?? user.email ?? '?')[0].toUpperCase()}</div>
    </div>
  </div>
</div>

<div class="cover">
  <div class="profile-row">

    <div class="name-section">
      <div id="username" class="name">{user.name ?? user.email}</div>
      <div id="editControls">
        <button class="edit-btn" onclick="enterEditMode()">Edit Profile</button>
      </div>
    </div>

    <div class="avatar">
      {(user.name ?? user.email ?? '?')[0].toUpperCase()}
    </div>

  </div>
</div>

<div class="container">

<h2 class="section-title">About</h2>

<div class="cards">
  <div class="card">
    <strong>Bio</strong>
    <p id="bioText">{user.bio || 'Add a bio...'}</p>
  </div>

  <div class="card">
    <strong>Major</strong>
    <p id="majorText">{user.major || 'Not set'}</p>
  </div>

  <div class="card">
    <strong>School</strong>
    <p id="schoolText">{user.school || 'Not set'}</p>
  </div>
</div>

<h2 class="section-title">Recent Learning Logs</h2>

{posts.length > 0 ? (
  <div class="cards">
    {posts.slice(0, 3).map((post: any) => (
      <div class="card">
        <strong><a href={`/posts/${post.slug}`} style="color:inherit;text-decoration:none">{post.title}</a></strong>
        <p>{post.deck ?? ''}</p>
      </div>
    ))}
  </div>
) : (
  <p class="empty-state">No learning logs yet. <a href="/posts/new">Create your first post.</a></p>
)}

</div>

<script>
import { updateProfile } from '../lib/auth';

const profileData = document.getElementById('profileData') as HTMLElement;
const userId = profileData.dataset.id!;

function makeInput(id: string, value: string) {
  const el = document.getElementById(id)!;
  const input = document.createElement('input');
  input.value = value;
  input.id = id;
  el.replaceWith(input);
}

function enterEditMode() {
  document.getElementById('editControls')!.innerHTML = `
    <button class="save-btn" onclick="saveProfile()">Save</button>
  `;

  makeInput('username', profileData.dataset.name!);
  makeInput('bioText', profileData.dataset.bio!);
  makeInput('majorText', profileData.dataset.major!);
  makeInput('schoolText', profileData.dataset.school!);
}

async function saveProfile() {
  const name = (document.getElementById('username') as HTMLInputElement).value.trim();
  const bio = (document.getElementById('bioText') as HTMLInputElement).value.trim();
  const major = (document.getElementById('majorText') as HTMLInputElement).value.trim();
  const school = (document.getElementById('schoolText') as HTMLInputElement).value.trim();

  try {
    await updateProfile(userId, { name, bio, major, school });
    location.reload();
  } catch (err) {
    alert('Failed to save: ' + (err as Error).message);
  }
}

// Expose to inline onclick handlers
(window as any).enterEditMode = enterEditMode;
(window as any).saveProfile = saveProfile;
</script>

</body>
</html>
