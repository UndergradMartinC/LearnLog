---
export const prerender = true;
const title = "About | LearnLog";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;1,400&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&display=swap" rel="stylesheet" />

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --font-serif: 'Lora', Georgia, serif;
      --font-sans:  'DM Sans', system-ui, sans-serif;
      --color-bg:         #f7f6f3;
      --color-surface:    #ffffff;
      --color-border:     #e4e2db;
      --color-text:       #2d2d2d;
      --color-text-2:     #5e6278;
      --color-text-muted: #9090a0;
      --color-accent:     #3d5a78;
    }

    body {
      font-family: var(--font-sans);
      background: var(--color-bg);
      color: var(--color-text);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }

    a { text-decoration: none; }

    /* ─── NAVBAR ─── */
    .navbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1.125rem 2.5rem;
      background: var(--color-surface);
      border-bottom: 1px solid var(--color-border);
    }
    .logo {
      font-family: var(--font-serif);
      font-size: 1.25rem;
      font-weight: 600;
      color: var(--color-text);
      letter-spacing: -0.01em;
    }
    .nav-links { display: flex; align-items: center; gap: 1.5rem; }
    .nav-links a {
      font-size: 0.875rem;
      font-weight: 500;
      color: var(--color-text-2);
      transition: color 0.12s;
    }
    .nav-links a:hover,
    .nav-links a.active { color: var(--color-text); }
    .nav-actions { display: flex; align-items: center; gap: 1rem; }
    .nav-login {
      font-size: 0.875rem;
      font-weight: 500;
      color: var(--color-text-2);
      transition: color 0.12s;
    }
    .nav-login:hover { color: var(--color-text); }
    .nav-signup {
      font-size: 0.875rem;
      font-weight: 600;
      color: var(--color-surface);
      background: var(--color-text);
      padding: 0.45rem 1rem;
      border-radius: 5px;
      transition: opacity 0.12s;
    }
    .nav-signup:hover { opacity: 0.8; }

    /* ─── HERO ─── */
    .hero {
      background: var(--color-surface);
      border-bottom: 1px solid var(--color-border);
      padding: clamp(3.5rem, 8vw, 5.5rem) 2.5rem clamp(3rem, 6vw, 4.5rem);
    }
    .hero-inner { max-width: 56rem; margin: 0 auto; }
    .hero-label {
      font-size: 0.6875rem;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--color-text-muted);
      margin-bottom: 1.5rem;
    }
    .hero h1 {
      font-family: var(--font-serif);
      font-size: clamp(2.25rem, 5vw, 3.75rem);
      font-weight: 600;
      line-height: 1.1;
      letter-spacing: -0.03em;
      color: var(--color-text);
      max-width: 22ch;
      margin-bottom: 1.5rem;
    }
    .hero-body {
      font-size: clamp(1rem, 1.5vw, 1.0625rem);
      color: var(--color-text-2);
      line-height: 1.75;
      max-width: 50ch;
    }

    /* ─── SECTION SHARED ─── */
    .section-inner { max-width: 56rem; margin: 0 auto; }
    .section-label {
      font-size: 0.6875rem;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--color-text-muted);
      margin-bottom: 2rem;
    }

    /* ─── MISSION ─── */
    .mission {
      background: var(--color-bg);
      border-bottom: 1px solid var(--color-border);
      padding: clamp(3rem, 6vw, 5rem) 2.5rem;
    }
    .mission-grid {
      display: grid;
      grid-template-columns: 3fr 2fr;
      gap: 4rem;
      align-items: start;
    }
    .mission-text h2 {
      font-family: var(--font-serif);
      font-size: clamp(1.5rem, 3vw, 2.125rem);
      font-weight: 600;
      letter-spacing: -0.025em;
      color: var(--color-text);
      margin-bottom: 1.25rem;
      line-height: 1.2;
    }
    .mission-text p {
      font-size: 0.9375rem;
      color: var(--color-text-2);
      line-height: 1.8;
      margin-bottom: 1rem;
    }
    .mission-text p:last-child { margin-bottom: 0; }

    /* ─── STATS ─── */
    .stats {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0;
      border: 1px solid var(--color-border);
      border-radius: 8px;
      overflow: hidden;
      background: var(--color-surface);
    }
    .stat {
      padding: 1.5rem;
      border-right: 1px solid var(--color-border);
      border-bottom: 1px solid var(--color-border);
    }
    .stat:nth-child(2n) { border-right: none; }
    .stat:nth-last-child(-n+2) { border-bottom: none; }
    .stat-num {
      font-family: var(--font-serif);
      font-size: 2rem;
      font-weight: 600;
      color: var(--color-accent);
      letter-spacing: -0.03em;
      line-height: 1;
      margin-bottom: 0.35rem;
    }
    .stat-label {
      font-size: 0.8125rem;
      color: var(--color-text-muted);
      line-height: 1.4;
    }

    /* ─── TEAM ─── */
    .team {
      background: var(--color-surface);
      border-bottom: 1px solid var(--color-border);
      padding: clamp(3rem, 6vw, 5rem) 2.5rem;
    }
    .team-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      border-top: 1px solid var(--color-border);
    }
    .team-member {
      padding: 1.75rem 1.75rem 1.75rem 0;
      border-right: 1px solid var(--color-border);
      border-bottom: 1px solid var(--color-border);
    }
    .team-member:nth-child(3n) { border-right: none; padding-right: 0; }
    .team-member:nth-last-child(-n+3) { border-bottom: none; }
    .member-initial {
      width: 2.25rem;
      height: 2.25rem;
      border-radius: 50%;
      border: 1px solid var(--color-border);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-serif);
      font-size: 0.75rem;
      font-weight: 600;
      color: var(--color-text-2);
      background: var(--color-bg);
      margin-bottom: 1rem;
    }
    .member-name {
      font-family: var(--font-serif);
      font-size: 1rem;
      font-weight: 600;
      color: var(--color-text);
      margin-bottom: 0.2rem;
      letter-spacing: -0.01em;
    }
    .member-role {
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--color-accent);
      margin-bottom: 0.75rem;
    }
    .member-desc {
      font-size: 0.8125rem;
      color: var(--color-text-2);
      line-height: 1.65;
    }

    /* ─── VALUES ─── */
    .values {
      background: var(--color-bg);
      border-bottom: 1px solid var(--color-border);
      padding: clamp(3rem, 6vw, 5rem) 2.5rem;
    }
    .values-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 2.5rem 4.5rem;
    }
    .value-title {
      font-family: var(--font-serif);
      font-size: 1.0625rem;
      font-weight: 600;
      color: var(--color-text);
      margin-bottom: 0.5rem;
      line-height: 1.3;
    }
    .value-desc {
      font-size: 0.875rem;
      color: var(--color-text-2);
      line-height: 1.7;
    }

    /* ─── TIMELINE ─── */
    .timeline-section {
      background: var(--color-surface);
      border-bottom: 1px solid var(--color-border);
      padding: clamp(3rem, 6vw, 5rem) 2.5rem;
    }
    .timeline {
      position: relative;
      padding-left: 2rem;
      max-width: 44rem;
    }
    .timeline::before {
      content: '';
      position: absolute;
      left: 5px;
      top: 8px;
      bottom: 8px;
      width: 1px;
      background: var(--color-border);
    }
    .timeline-item {
      position: relative;
      margin-bottom: 2rem;
    }
    .timeline-item:last-child { margin-bottom: 0; }
    .timeline-dot {
      position: absolute;
      left: -1.875rem;
      top: 7px;
      width: 11px;
      height: 11px;
      border-radius: 50%;
      background: var(--color-surface);
      border: 2px solid var(--color-accent);
    }
    .timeline-date {
      font-size: 0.6875rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--color-accent);
      display: block;
      margin-bottom: 0.35rem;
    }
    .timeline-heading {
      font-family: var(--font-serif);
      font-size: 1rem;
      font-weight: 600;
      color: var(--color-text);
      margin-bottom: 0.5rem;
      letter-spacing: -0.01em;
    }
    .timeline-body {
      font-size: 0.875rem;
      color: var(--color-text-2);
      line-height: 1.7;
    }

    /* ─── CTA ─── */
    .cta {
      padding: clamp(3.5rem, 7vw, 5.5rem) 2.5rem;
      background: var(--color-bg);
    }
    .cta-inner { max-width: 56rem; margin: 0 auto; }
    .cta h2 {
      font-family: var(--font-serif);
      font-size: clamp(1.75rem, 4vw, 2.75rem);
      font-weight: 600;
      letter-spacing: -0.025em;
      color: var(--color-text);
      max-width: 22ch;
      margin-bottom: 0.875rem;
      line-height: 1.15;
    }
    .cta p {
      font-size: 1rem;
      color: var(--color-text-2);
      margin-bottom: 2rem;
      max-width: 40ch;
    }
    .btn-primary {
      display: inline-block;
      background: var(--color-text);
      color: var(--color-surface);
      font-size: 0.9375rem;
      font-weight: 600;
      padding: 0.7rem 1.5rem;
      border-radius: 6px;
      transition: opacity 0.12s;
    }
    .btn-primary:hover { opacity: 0.8; }

    /* ─── FOOTER ─── */
    .footer {
      background: #1c1c2a;
      color: #7a7a95;
      padding: 1.75rem 2.5rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.5rem;
      font-size: 0.8125rem;
    }
    .footer-brand {
      font-family: var(--font-serif);
      font-size: 0.9375rem;
      font-weight: 600;
      color: #c8c8d8;
    }

    @media (max-width: 768px) {
      .mission-grid { grid-template-columns: 1fr; gap: 2.5rem; }
      .stats { grid-template-columns: 1fr 1fr; }
    }
    @media (max-width: 640px) {
      .navbar { padding: 1rem 1.25rem; }
      .hero, .mission, .team, .values, .timeline-section, .cta { padding-left: 1.25rem; padding-right: 1.25rem; }
      .team-grid { grid-template-columns: 1fr; }
      .team-member {
        border-right: none;
        padding-right: 0;
        padding-bottom: 1.5rem;
        border-bottom: 1px solid var(--color-border);
      }
      .team-member:last-child { border-bottom: none; }
      .values-grid { grid-template-columns: 1fr; gap: 1.75rem; }
      .footer { flex-direction: column; align-items: flex-start; }
    }
  </style>
</head>

<body>

  <!-- NAVBAR -->
  <nav class="navbar">
    <a href="/" class="logo">LearnLog</a>
    <div class="nav-links">
      <a href="/features">Features</a>
      <a href="/about" class="active">About</a>
    </div>
    <div class="nav-actions">
      <a href="/login" class="nav-login">Sign in</a>
      <a href="/signup" class="nav-signup">Get started</a>
    </div>
  </nav>

  <!-- HERO -->
  <section class="hero">
    <div class="hero-inner">
      <p class="hero-label">About LearnLog</p>
      <h1>Built by students, for students who take learning seriously.</h1>
      <p class="hero-body">
        We're a team of UL Lafayette CS students who wanted a better place
        to document and share what we learn — something peers could read,
        not just professors.
      </p>
    </div>
  </section>

  <!-- MISSION -->
  <section class="mission">
    <div class="section-inner">
      <div class="mission-grid">
        <div class="mission-text">
          <p class="section-label">Our mission</p>
          <h2>A place for learning in progress.</h2>
          <p>Students don't have a place to share their understanding of classroom material. Existing platforms cater to professionals and experts — which can be intimidating for students still in the learning process.</p>
          <p>LearnLog is a web app that lets peers create, share, and engage with educational content written at a relatable level. It's part personal learning journal, part peer knowledge exchange.</p>
          <p>Learning is better together. LearnLog creates a space where students can grow alongside peers who are on the same journey — asking the same questions and figuring things out in real time.</p>
        </div>
        <div>
          <div class="stats">
            <div class="stat">
              <div class="stat-num">6</div>
              <div class="stat-label">Team members</div>
            </div>
            <div class="stat">
              <div class="stat-num">9</div>
              <div class="stat-label">Weeks to build</div>
            </div>
            <div class="stat">
              <div class="stat-num">4</div>
              <div class="stat-label">Milestones</div>
            </div>
            <div class="stat">
              <div class="stat-num">'26</div>
              <div class="stat-label">Launched</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TEAM -->
  <section class="team">
    <div class="section-inner">
      <p class="section-label">The people</p>
      <div class="team-grid">
        <div class="team-member">
          <div class="member-initial">MC</div>
          <div class="member-name">Martin C.</div>
          <div class="member-role">Backend & DevOps</div>
          <p class="member-desc">Developed post management APIs, the search API, and the CI/CD pipeline for production deployment.</p>
        </div>
        <div class="team-member">
          <div class="member-initial">MC</div>
          <div class="member-name">Max C.</div>
          <div class="member-role">Backend Engineer</div>
          <p class="member-desc">Built the like/dislike APIs and co-developed authentication and sign-in infrastructure.</p>
        </div>
        <div class="team-member">
          <div class="member-initial">RJ</div>
          <div class="member-name">Ryann J.</div>
          <div class="member-role">Frontend Engineer</div>
          <p class="member-desc">Built the home page, user profile, about, and features pages. Led frontend testing.</p>
        </div>
        <div class="team-member">
          <div class="member-initial">CK</div>
          <div class="member-name">Cody K.</div>
          <div class="member-role">Backend Engineer</div>
          <p class="member-desc">Implemented sign-in functions, RBAC validation, and the follower system.</p>
        </div>
        <div class="team-member">
          <div class="member-initial">JP</div>
          <div class="member-name">Jacob P.</div>
          <div class="member-role">Full Stack Engineer</div>
          <p class="member-desc">Designed the database schema and built APIs for replies, deletes, and social features. Led backend testing.</p>
        </div>
        <div class="team-member">
          <div class="member-initial">RP</div>
          <div class="member-name">Raven P.</div>
          <div class="member-role">Frontend Engineer</div>
          <p class="member-desc">Built the login, sign-up, view blogs, create blog, dashboard, and search filtering UI.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- VALUES -->
  <section class="values">
    <div class="section-inner">
      <p class="section-label">What we stand for</p>
      <div class="values-grid">
        <div class="value">
          <h3 class="value-title">Learn in public</h3>
          <p class="value-desc">Growth happens faster when knowledge is shared. We encourage learners to document and publish their journey openly — imperfect notes included.</p>
        </div>
        <div class="value">
          <h3 class="value-title">Consistent progress</h3>
          <p class="value-desc">Small, consistent steps compound into massive growth over time. LearnLog is built around daily documentation habits, not big achievements.</p>
        </div>
        <div class="value">
          <h3 class="value-title">Community first</h3>
          <p class="value-desc">The best learning environments are collaborative. Comments, likes, and shared insights make everyone on the platform better.</p>
        </div>
        <div class="value">
          <h3 class="value-title">Own your growth</h3>
          <p class="value-desc">Your learning history is your portfolio. LearnLog gives you full control over how you document and present your journey to the world.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- TIMELINE -->
  <section class="timeline-section">
    <div class="section-inner">
      <p class="section-label">How we got here</p>
      <div class="timeline">
        <div class="timeline-item">
          <div class="timeline-dot"></div>
          <span class="timeline-date">Weeks 1–2 · Foundation</span>
          <h3 class="timeline-heading">The beginning</h3>
          <p class="timeline-body">We set up the GitHub repo, designed the database schema, and built the landing, login, and sign-up pages. Authentication and RBAC validation were implemented so users could securely create accounts and log in.</p>
        </div>
        <div class="timeline-item">
          <div class="timeline-dot"></div>
          <span class="timeline-date">Weeks 3–5 · Core features</span>
          <h3 class="timeline-heading">Building the platform</h3>
          <p class="timeline-body">We shipped full CRUD APIs for blog posts, a like/dislike system, and a comment and reply feature. On the frontend, the view blogs page, create blog page, user profile pages, and the dashboard all came to life.</p>
        </div>
        <div class="timeline-item">
          <div class="timeline-dot"></div>
          <span class="timeline-date">Weeks 6–7 · Enhanced features</span>
          <h3 class="timeline-heading">Community & discovery</h3>
          <p class="timeline-body">We added a follower system so users could build a personalized feed, and launched search with topic, author, and date filtering. E2E and integration testing locked in stability across all core user flows.</p>
        </div>
        <div class="timeline-item">
          <div class="timeline-dot"></div>
          <span class="timeline-date">Weeks 8–9 · Launch</span>
          <h3 class="timeline-heading">Production ready</h3>
          <p class="timeline-body">A CI/CD pipeline was set up so every merge to main auto-deploys. After final manual testing, performance tuning, and polish, LearnLog went live — a fully functional platform built start to finish by our team.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta">
    <div class="cta-inner">
      <h2>Start your learning log today.</h2>
      <p>Free to use. No setup required. Just open it and write.</p>
      <a href="/signup" class="btn-primary">Create your account</a>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="footer">
    <span class="footer-brand">LearnLog</span>
    <span>© 2026 · Built by UL Lafayette CS Students</span>
  </footer>

</body>
</html>
