---
const PAYLOAD_URL = import.meta.env.PUBLIC_PAYLOAD_URL ?? 'http://localhost:3000';
const cookie = Astro.request.headers.get('cookie') ?? '';

const meRes = await fetch(`${PAYLOAD_URL}/api/users/me`, { headers: { cookie } });
if (!meRes.ok) return Astro.redirect('/login');
const { user } = await meRes.json();

const title = "Edit Profile — LearnLog";
---

<html lang="en">
<head>
<meta charset="UTF-8" />
<title>{title}</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;1,400&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&display=swap" rel="stylesheet" />

<style>
* { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --font-serif: 'Lora', Georgia, serif;
  --font-sans:  'DM Sans', system-ui, sans-serif;
  --text-xs:    0.6875rem;
  --text-sm:    0.8125rem;
  --text-base:  1rem;
  --text-lg:    1.125rem;
  --color-bg:         #f7f6f3;
  --color-surface:    #ffffff;
  --color-border:     #e4e2db;
  --color-text:       #2d2d2d;
  --color-text-2:     #5e6278;
  --color-text-muted: #9090a0;
  --color-accent:     #3d5a78;
  --color-error:      #b91c1c;
}

body {
  font-family: var(--font-sans);
  background: var(--color-bg);
  color: var(--color-text);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

/* ─── NAVBAR ─── */
.navbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1.125rem 2.5rem;
  background: var(--color-surface);
  border-bottom: 1px solid var(--color-border);
}
.logo {
  font-family: var(--font-serif);
  font-size: 1.25rem;
  font-weight: 600;
  color: var(--color-text);
  letter-spacing: -0.01em;
  text-decoration: none;
}
.nav-links { display: flex; align-items: center; }
.nav-links a {
  margin-left: 1.25rem;
  color: var(--color-text-2);
  font-size: var(--text-sm);
  font-weight: 500;
  text-decoration: none;
  transition: color 0.12s;
}
.nav-links a:hover { color: var(--color-text); }

/* ─── FORM AREA ─── */
.form-area {
  max-width: 36rem;
  margin: 0 auto;
  padding: 2.5rem 2.5rem 4rem;
}

.back-link {
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  font-size: var(--text-sm);
  color: var(--color-text-2);
  text-decoration: none;
  margin-bottom: 2rem;
  transition: color 0.12s;
}
.back-link:hover { color: var(--color-text); }

.form-heading {
  font-family: var(--font-serif);
  font-size: 1.75rem;
  font-weight: 600;
  letter-spacing: -0.025em;
  color: var(--color-text);
  margin-bottom: 0.3rem;
}
.form-subheading {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  margin-bottom: 2.25rem;
}

/* ─── ERROR BANNER ─── */
.error-banner {
  display: none;
  background: #fef2f2;
  border: 1px solid #fecaca;
  border-radius: 6px;
  padding: 0.75rem 1rem;
  font-size: var(--text-sm);
  color: var(--color-error);
  margin-bottom: 1.5rem;
}
.error-banner.visible { display: block; }

/* ─── FIELDS ─── */
.field { margin-bottom: 1.5rem; }

label {
  display: block;
  font-size: var(--text-sm);
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 0.4rem;
  letter-spacing: 0.005em;
}
.field-hint {
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  margin-top: 0.35rem;
}

input, textarea {
  width: 100%;
  padding: 0.625rem 0.75rem;
  border: 1px solid var(--color-border);
  border-radius: 6px;
  font-size: var(--text-base);
  font-family: var(--font-sans);
  color: var(--color-text);
  background: var(--color-surface);
  transition: border-color 0.15s, box-shadow 0.15s;
  appearance: none;
}
input:focus, textarea:focus {
  outline: none;
  border-color: var(--color-accent);
  box-shadow: 0 0 0 3px rgba(61, 90, 120, 0.12);
}
textarea {
  resize: vertical;
  min-height: 120px;
  line-height: 1.65;
}

/* ─── ACTIONS ─── */
.divider {
  border: none;
  border-top: 1px solid var(--color-border);
  margin: 2rem 0 1.5rem;
}
.actions {
  display: flex;
  align-items: center;
  gap: 1rem;
}
.save-btn {
  background: var(--color-text);
  color: var(--color-surface);
  border: none;
  padding: 0.625rem 1.5rem;
  border-radius: 6px;
  font-family: var(--font-sans);
  font-size: var(--text-sm);
  font-weight: 600;
  cursor: pointer;
  letter-spacing: 0.01em;
  transition: opacity 0.14s;
}
.save-btn:hover:not(:disabled) { opacity: 0.8; }
.save-btn:disabled { opacity: 0.45; cursor: not-allowed; }
.cancel-link {
  font-size: var(--text-sm);
  font-weight: 500;
  color: var(--color-text-2);
  text-decoration: none;
  transition: color 0.12s;
}
.cancel-link:hover { color: var(--color-text); }
</style>
</head>

<body>

<div id="userId" data-id={user.id} style="display:none"></div>

<nav class="navbar">
  <a href="/" class="logo">LearnLog</a>
  <div class="nav-links">
    <a href="/dashboard">Dashboard</a>
    <a href="/posts/new">New Post</a>
    <a href="/profile">Profile</a>
  </div>
</nav>

<div class="form-area">
  <a href="/profile" class="back-link">← Back to profile</a>

  <h1 class="form-heading">Edit Profile</h1>
  <p class="form-subheading">Update how others see you on LearnLog.</p>

  <div
    id="errorBanner"
    class="error-banner"
    role="alert"
    aria-live="polite"
  ></div>

  <div class="field">
    <label for="name">Name</label>
    <input id="name" type="text" value={user.name ?? ''} placeholder="Your name" autocomplete="name" />
  </div>

  <div class="field">
    <label for="bio">Bio</label>
    <textarea id="bio" placeholder="Tell others about what you're learning">{user.bio ?? ''}</textarea>
    <p class="field-hint">Shown on your profile. Keep it short and honest.</p>
  </div>

  <div class="field">
    <label for="major">Major</label>
    <input id="major" type="text" value={user.major ?? ''} placeholder="e.g. Computer Science" />
  </div>

  <div class="field">
    <label for="school">School</label>
    <input id="school" type="text" value={user.school ?? ''} placeholder="e.g. University of Michigan" />
  </div>

  <hr class="divider" />

  <div class="actions">
    <button id="saveBtn" class="save-btn">Save changes</button>
    <a href="/profile" class="cancel-link">Cancel</a>
  </div>
</div>

<script>
import { updateProfile } from '../../lib/auth';

const userId = (document.getElementById('userId') as HTMLElement).dataset.id!;
const saveBtn = document.getElementById('saveBtn') as HTMLButtonElement;
const errorBanner = document.getElementById('errorBanner') as HTMLElement;

function showError(msg: string) {
  errorBanner.textContent = msg;
  errorBanner.classList.add('visible');
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

function humanizeError(err: Error): string {
  const msg = err.message ?? '';
  if (msg.includes('401') || msg.includes('Unauthorized'))
    return 'Your session has expired. Please log in again.';
  if (msg.includes('422') || msg.includes('validation'))
    return 'One or more fields are invalid. Please check your inputs.';
  if (msg.includes('NetworkError') || msg.includes('Failed to fetch'))
    return 'Connection problem. Check your internet connection and try again.';
  return 'Something went wrong. Please try again.';
}

saveBtn.addEventListener('click', async () => {
  errorBanner.classList.remove('visible');

  const name   = (document.getElementById('name')   as HTMLInputElement).value.trim();
  const bio    = (document.getElementById('bio')    as HTMLTextAreaElement).value.trim();
  const major  = (document.getElementById('major')  as HTMLInputElement).value.trim();
  const school = (document.getElementById('school') as HTMLInputElement).value.trim();

  saveBtn.disabled = true;
  saveBtn.textContent = 'Saving…';

  try {
    await updateProfile(userId, { name, bio, major, school });
    window.location.href = '/profile';
  } catch (err) {
    showError(humanizeError(err as Error));
    saveBtn.disabled = false;
    saveBtn.textContent = 'Save changes';
  }
});
</script>

</body>
</html>
