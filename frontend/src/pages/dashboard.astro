---
const PAYLOAD_URL = import.meta.env.PUBLIC_PAYLOAD_URL ?? 'http://localhost:3000';
const cookie = Astro.request.headers.get('cookie') ?? '';

const res = await fetch(`${PAYLOAD_URL}/api/users/me`, {
  headers: { cookie },
});

if (!res.ok) {
  return Astro.redirect('/login');
}

const title = "Dashboard | LearnLog";
---

<html lang="en">
<head>
<meta charset="UTF-8" />
<title>{title}</title>

<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: Arial, Helvetica, sans-serif; margin: 0; background: #f8fafc; color: #333; }

.navbar { display:flex; justify-content:space-between; align-items:center; padding:18px 40px; background:white; box-shadow:0 2px 6px rgba(0,0,0,0.08); position:relative; z-index:10; }
.logo { font-size:22px; font-weight:bold; color:#2563eb; }
.nav-links a { margin-left:20px; color:#333; font-weight:500; }
.logout-btn { margin-left:20px; background:#6c63ff; color:white; border:none; padding:8px 18px; border-radius:8px; font-size:14px; font-weight:500; cursor:pointer; }

.main-container { display:flex; justify-content:center; align-items:center; height:calc(100vh - 70px); }

.welcome-card { background:white; border-radius:18px; padding:60px 80px; text-align:center; box-shadow:0 25px 50px rgba(0,0,0,0.18); }
.welcome-card h1 { font-size:36px; color:#2563eb; margin-bottom:12px; }
.welcome-card p { font-size:16px; color:#666; }

.footer { background:#111827; color:white; padding:30px; text-align:center; font-size:14px; }
</style>
</head>

<body>

<!-- NAVBAR -->
<nav class="navbar">
  <div class="logo">LearnLog</div>
  <div class="nav-links">
    <a href="#">Features</a>
    <a href="#">Explore</a>
    <a href="#">About</a>
    <button class="logout-btn" id="logout-btn">Logout</button>
  </div>
</nav>

<!-- DASHBOARD CONTENT -->
<div class="main-container">
  <div class="welcome-card">
    <h1>You have logged in</h1>
    <p>Posts from other learners will appear here soon.</p>
  </div>
</div>

<!-- FOOTER -->
<footer class="footer">
  <p>© 2026 LearnLog</p>
  <p>Built by UL Lafayette CS Students</p>
</footer>

<script>
  import { signOut } from '../lib/auth';

  document.addEventListener('DOMContentLoaded', () => {
    document.getElementById('logout-btn')!.addEventListener('click', async () => {
      await signOut();
      window.location.href = '/login';
    });
  });
</script>

</body>
</html>
