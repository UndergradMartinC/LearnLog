---
const PAYLOAD_URL = import.meta.env.PUBLIC_PAYLOAD_URL ?? 'http://localhost:3000';
const cookie = Astro.request.headers.get('cookie') ?? '';

const res = await fetch(`${PAYLOAD_URL}/api/users/me`, {
  headers: { cookie },
});

if (!res.ok) {
  return Astro.redirect('/login');
}
const meData = await res.json();
if (!meData.user?.id) return Astro.redirect('/login');

const postsRes = await fetch(`${PAYLOAD_URL}/api/posts/?depth=1`, {
  headers: { cookie },
});
const postsData = postsRes.ok ? await postsRes.json() : { docs: [] };
const posts: any[] = postsData.docs ?? [];

const title = "Dashboard | LearnLog";
const showCreated = Astro.url.searchParams.get('created') === '1';
const showSaved   = Astro.url.searchParams.get('saved')   === '1';
const showWelcome = Astro.url.searchParams.get('welcome') === '1';
const postSlug    = Astro.url.searchParams.get('slug') ?? '';
---

<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;1,400&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&display=swap" rel="stylesheet" />

<style>
* { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --font-serif: 'Lora', Georgia, serif;
  --font-sans: 'DM Sans', system-ui, sans-serif;

  --text-xs:   0.6875rem;
  --text-sm:   0.8125rem;
  --text-base: 1rem;
  --text-lg:   1.125rem;
  --text-xl:   1.75rem;

  --color-bg:         #f7f6f3;
  --color-surface:    #ffffff;
  --color-border:     #e4e2db;
  --color-text:       #2d2d2d;
  --color-text-2:     #5e6278;
  --color-text-muted: #9090a0;
  --color-accent:     #3d5a78;
}

body {
  font-family: var(--font-sans);
  font-size: var(--text-base);
  line-height: 1.6;
  margin: 0;
  background: var(--color-bg);
  color: var(--color-text);
  font-kerning: normal;
  -webkit-font-smoothing: antialiased;
}

.navbar {
  display: flex; justify-content: space-between; align-items: center;
  padding: 1.125rem 2.5rem;
  background: var(--color-surface);
  border-bottom: 1px solid var(--color-border);
  position: relative; z-index: 10;
}
.logo {
  font-family: var(--font-serif);
  font-size: 1.25rem;
  font-weight: 600;
  color: var(--color-text);
  letter-spacing: -0.01em;
  text-decoration: none;
}
.nav-links a {
  margin-left: 1.25rem;
  color: var(--color-text-2);
  font-size: var(--text-sm);
  font-weight: 500;
  text-decoration: none;
  transition: color 0.12s;
}
.nav-links a:hover { color: var(--color-text); }
.nav-links a.active { color: var(--color-text); font-weight: 600; }
.logout-btn {
  margin-left: 1.25rem;
  background: transparent;
  color: var(--color-text-muted);
  border: none;
  padding: 0.5rem 0;
  font-family: var(--font-sans);
  font-size: var(--text-sm);
  font-weight: 500;
  cursor: pointer;
  transition: color 0.12s;
}
.logout-btn:hover { color: var(--color-text); }

.posts-section { max-width: 68.75rem; margin: 3rem auto; padding: 0 1.5rem; }
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 1.75rem;
}
.posts-section h1 {
  font-family: var(--font-serif);
  font-size: var(--text-xl);
  font-weight: 600;
  color: var(--color-text);
  letter-spacing: -0.02em;
  line-height: 1.2;
}
.new-post-btn {
  display: inline-block;
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--color-surface);
  background: var(--color-text);
  padding: 0.45rem 1rem;
  border-radius: 5px;
  text-decoration: none;
  transition: opacity 0.12s;
  flex-shrink: 0;
}
.new-post-btn:hover { opacity: 0.8; }

.posts-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(17.5rem, 1fr)); gap: 1.25rem; }

.post-link {
  text-decoration: none;
  color: inherit;
  display: block;
  height: 100%;
}
.post-card {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: 8px;
  padding: 1.5rem;
  display: flex; flex-direction: column; gap: 0.625rem;
  transition: border-color 0.15s, box-shadow 0.15s;
  height: 100%;
}
.post-link:hover .post-card {
  border-color: #b8b4ac;
  box-shadow: 0 2px 8px rgba(0,0,0,0.06);
}
.post-card h2 {
  font-family: var(--font-serif);
  font-size: var(--text-lg);
  font-weight: 600;
  color: var(--color-text);
  line-height: 1.3;
  letter-spacing: -0.01em;
  overflow-wrap: break-word;
}
.post-byline {
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  margin-top: -0.25rem;
}
.post-deck {
  font-size: var(--text-sm);
  color: var(--color-text-2);
  line-height: 1.65;
  overflow-wrap: break-word;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.post-meta {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap;
  margin-top: auto;
  padding-top: 0.75rem;
  font-variant-numeric: tabular-nums;
}

.badge {
  font-size: var(--text-xs);
  font-weight: 600;
  padding: 0.125rem 0.5rem;
  border-radius: 99px;
  text-transform: uppercase;
  letter-spacing: 0.06em;
}
.badge-published { background: #ecfdf5; color: #16a34a; }
.badge-draft     { background: #fefce8; color: #a16207; }

.reaction-counts { color: var(--color-text-muted); font-size: var(--text-xs); }

.post-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.375rem;
}
.tag {
  font-size: var(--text-xs);
  font-weight: 500;
  color: var(--color-text-2);
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: 99px;
  padding: 0.1rem 0.55rem;
  letter-spacing: 0.01em;
}

.empty-state {
  text-align: center;
  color: var(--color-text-muted);
  padding: 3.75rem 0;
  font-family: var(--font-serif);
  font-size: var(--text-base);
  font-style: italic;
}
.empty-state a {
  color: var(--color-accent);
  text-decoration: none;
}
.empty-state a:hover { text-decoration: underline; }

.search-wrap { margin-bottom: 1.5rem; position: relative; }
.search-icon {
  position: absolute;
  left: 0.75rem;
  top: 50%;
  transform: translateY(-50%);
  width: 0.9375rem;
  height: 0.9375rem;
  color: var(--color-text-muted);
  pointer-events: none;
  transition: color 0.12s;
}
.search-wrap:has(.post-search:focus) .search-icon { color: var(--color-accent); }
.post-search {
  width: 100%;
  padding: 0.625rem 1rem 0.625rem 2.25rem;
  font-family: var(--font-sans);
  font-size: var(--text-sm);
  border: 1px solid var(--color-border);
  border-radius: 6px;
  background: var(--color-surface);
  color: var(--color-text);
  outline: none;
  transition: border-color 0.12s, box-shadow 0.12s;
}
.post-search:focus {
  border-color: var(--color-accent);
  box-shadow: 0 0 0 3px rgba(61,90,120,0.1);
}
.post-search::placeholder { color: var(--color-text-muted); }

.success-banner {
  background: #f0f7f4;
  border-bottom: 1px solid #c8e6d8;
  color: #1a5c3a;
  font-size: var(--text-sm);
  font-weight: 500;
  padding: 0.75rem 2.5rem;
  letter-spacing: 0.01em;
}
.saved-banner {
  background: #fefce8;
  border-bottom: 1px solid #fde68a;
  color: #78350f;
  font-size: var(--text-sm);
  font-weight: 500;
  padding: 0.75rem 2.5rem;
  letter-spacing: 0.01em;
}
.success-banner a { color: #1a5c3a; font-weight: 600; text-decoration: underline; text-underline-offset: 2px; margin-left: 0.375rem; }
.saved-banner a    { color: #78350f; font-weight: 600; text-decoration: underline; text-underline-offset: 2px; margin-left: 0.375rem; }
.welcome-banner {
  background: #f5f2ec;
  border-bottom: 1px solid #ddd8ce;
  color: var(--color-text-2);
  font-size: var(--text-sm);
  font-weight: 500;
  padding: 0.75rem 2.5rem;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}
.welcome-banner a {
  color: var(--color-accent);
  font-weight: 600;
  text-decoration: none;
}
.welcome-banner a:hover { text-decoration: underline; }

.footer {
  background: #1c1c2a;
  color: #a8a8b8;
  padding: 1.875rem;
  text-align: center;
  font-size: var(--text-sm);
  line-height: 1.8;
  margin-top: 3rem;
}
</style>
</head>

<body>

<!-- NAVBAR -->
<nav class="navbar">
  <a href="/dashboard" class="logo">LearnLog</a>
  <div class="nav-links">
    <a href="/dashboard" class="active">Dashboard</a>
    <a href="/posts/new">New Post</a>
    <a href="/profile">Profile</a>
    <button class="logout-btn" id="logout-btn">Logout</button>
  </div>
</nav>

{showCreated && (
  <div class="success-banner" id="success-banner">
    Post published.{postSlug && <a href={`/posts/${postSlug}`}>View it →</a>}
  </div>
)}
{showSaved && (
  <div class="saved-banner" id="saved-banner">
    Draft saved.{postSlug && <a href={`/posts/${postSlug}`}>View draft →</a>}
  </div>
)}
{showWelcome && (
  <div class="welcome-banner" id="welcome-banner">
    Welcome to LearnLog. <a href="/posts/new">Write your first learning log →</a>
  </div>
)}

<!-- DASHBOARD CONTENT -->
<section class="posts-section">
  <div class="section-header">
    <h1>Recent Posts</h1>
    <a href="/posts/new" class="new-post-btn">New Post</a>
  </div>
  {posts.length > 0 && (
    <div class="search-wrap">
      <svg class="search-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="8.5" cy="8.5" r="5.25" />
        <line x1="12.5" y1="12.5" x2="17" y2="17" />
      </svg>
      <input
        id="post-search"
        class="post-search"
        type="search"
        placeholder="Search posts…"
        autocomplete="off"
      />
    </div>
  )}

  {posts.length === 0 ? (
    <p class="empty-state">No posts yet. <a href="/posts/new">Write your first learning log →</a></p>
  ) : (
    <>
    <div class="posts-grid">
      {posts.map((post: any) => (
        <a href={`/posts/${post.slug}`} class="post-link" data-title={post.title ?? ''} data-deck={post.deck ?? ''}>
          <div class="post-card">
            <h2>{post.title}</h2>
            {(post.author?.name ?? post.author?.email) && (
              <p class="post-byline">by {post.author?.name ?? post.author?.email}</p>
            )}
            {post.deck && <p class="post-deck">{post.deck}</p>}
            {Array.isArray(post.tags) && post.tags.length > 0 && (
              <div class="post-tags">
                {post.tags.map((tag: any) => (
                  <span class="tag">{tag.name ?? tag}</span>
                ))}
              </div>
            )}
            <div class="post-meta">
              <span class={`badge badge-${post.status}`}>{post.status}</span>
              {(post.publishedAt ?? post.createdAt) && (
                <span>{new Date(post.publishedAt ?? post.createdAt).toLocaleDateString()}</span>
              )}
              {((post.likes?.length ?? 0) > 0 || (post.dislikes?.length ?? 0) > 0) && (
                <span class="reaction-counts">↑ {post.likes?.length ?? 0} · ↓ {post.dislikes?.length ?? 0}</span>
              )}
            </div>
          </div>
        </a>
      ))}
    </div>
    <p class="empty-state" id="no-results" style="display:none">No posts match your search. <a href="#" id="clear-search">Clear search →</a></p>
  </>
  )}
</section>

<script>
  import { signOut } from '../lib/auth';

  document.addEventListener('DOMContentLoaded', () => {
    document.getElementById('logout-btn')!.addEventListener('click', async () => {
      await signOut();
      window.location.href = '/login';
    });

    const url = new URL(window.location.href);
    url.searchParams.delete('created');
    url.searchParams.delete('saved');
    url.searchParams.delete('welcome');
    url.searchParams.delete('slug');
    window.history.replaceState({}, '', url.pathname);

    for (const id of ['success-banner', 'saved-banner', 'welcome-banner']) {
      const banner = document.getElementById(id);
      if (!banner) continue;
      if (id === 'success-banner' || id === 'saved-banner') {
        localStorage.removeItem('learnlog-draft');
      }
      setTimeout(() => {
        banner.style.transition = 'opacity 0.4s';
        banner.style.opacity = '0';
        setTimeout(() => banner.remove(), 400);
      }, 4000);
    }

    const searchInput = document.getElementById('post-search') as HTMLInputElement | null;
    if (searchInput) {
      let debounceTimer: ReturnType<typeof setTimeout>;
      const noResults = document.getElementById('no-results') as HTMLElement | null;

      function runFilter() {
        const q = searchInput!.value.toLowerCase().trim();
        const cards = document.querySelectorAll<HTMLElement>('.post-link[data-title]');
        let visible = 0;
        for (const card of cards) {
          const matches =
            !q ||
            (card.dataset.title ?? '').toLowerCase().includes(q) ||
            (card.dataset.deck ?? '').toLowerCase().includes(q);
          card.style.display = matches ? '' : 'none';
          if (matches) visible++;
        }
        if (noResults) noResults.style.display = visible === 0 ? '' : 'none';
      }

      searchInput.addEventListener('input', () => {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(runFilter, 150);
      });

      document.getElementById('clear-search')?.addEventListener('click', (e) => {
        e.preventDefault();
        searchInput.value = '';
        runFilter();
        searchInput.focus();
      });
    }
  });
</script>

</body>
</html>
