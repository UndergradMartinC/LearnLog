            "mimeType": "text/css",
            "text": "[data-astro-cid-3nssi2tu]{box-sizing:border-box;margin:0;padding:0}:root{--font-serif: \"Lora\", Georgia, serif;--font-sans: \"DM Sans\", system-ui, sans-serif;--text-xs: .6875rem;--text-sm: .8125rem;--text-base: 1rem;--text-lg: 1.125rem;--text-xl: 1.75rem;--color-bg: #f7f6f3;--color-surface: #ffffff;--color-border: #e4e2db;--color-text: #2d2d2d;--color-text-2: #5e6278;--color-text-muted: #9090a0;--color-accent: #3d5a78}body{font-family:var(--font-sans);font-size:var(--text-base);line-height:1.6;margin:0;background:var(--color-bg);color:var(--color-text);font-kerning:normal;-webkit-font-smoothing:antialiased}.navbar[data-astro-cid-3nssi2tu]{display:flex;justify-content:space-between;align-items:center;padding:1.125rem 2.5rem;background:var(--color-surface);border-bottom:1px solid var(--color-border);position:relative;z-index:10}.logo[data-astro-cid-3nssi2tu]{font-family:var(--font-serif);font-size:1.25rem;font-weight:600;color:var(--color-text);letter-spacing:-.01em;text-decoration:none}.nav-links[data-astro-cid-3nssi2tu] a[data-astro-cid-3nssi2tu]{margin-left:1.25rem;color:var(--color-text-2);font-size:var(--text-sm);font-weight:500;text-decoration:none;transition:color .12s}.nav-links[data-astro-cid-3nssi2tu] a[data-astro-cid-3nssi2tu]:hover{color:var(--color-text)}.nav-links[data-astro-cid-3nssi2tu] a[data-astro-cid-3nssi2tu].active{color:var(--color-text);font-weight:600}.logout-btn[data-astro-cid-3nssi2tu]{margin-left:1.25rem;background:transparent;color:var(--color-text-muted);border:none;padding:.5rem 0;font-family:var(--font-sans);font-size:var(--text-sm);font-weight:500;cursor:pointer;transition:color .12s}.logout-btn[data-astro-cid-3nssi2tu]:hover{color:var(--color-text)}.posts-section[data-astro-cid-3nssi2tu]{max-width:68.75rem;margin:3rem auto;padding:0 1.5rem}.section-header[data-astro-cid-3nssi2tu]{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:1.75rem}.posts-section[data-astro-cid-3nssi2tu] h1[data-astro-cid-3nssi2tu]{font-family:var(--font-serif);font-size:var(--text-xl);font-weight:600;color:var(--color-text);letter-spacing:-.02em;line-height:1.2}.new-post-btn[data-astro-cid-3nssi2tu]{display:inline-block;font-size:.875rem;font-weight:600;color:var(--color-surface);background:var(--color-text);padding:.45rem 1rem;border-radius:5px;text-decoration:none;transition:opacity .12s;flex-shrink:0}.new-post-btn[data-astro-cid-3nssi2tu]:hover{opacity:.8}.posts-grid[data-astro-cid-3nssi2tu]{display:grid;grid-template-columns:repeat(auto-fill,minmax(17.5rem,1fr));gap:1.25rem}.post-link[data-astro-cid-3nssi2tu]{text-decoration:none;color:inherit;display:block;height:100%}.post-card[data-astro-cid-3nssi2tu]{background:var(--color-surface);border:1px solid var(--color-border);border-radius:8px;padding:1.5rem;display:flex;flex-direction:column;gap:.625rem;transition:border-color .15s,box-shadow .15s;height:100%}.post-link[data-astro-cid-3nssi2tu]:hover .post-card[data-astro-cid-3nssi2tu]{border-color:#b8b4ac;box-shadow:0 2px 8px #0000000f}.post-card[data-astro-cid-3nssi2tu] h2[data-astro-cid-3nssi2tu]{font-family:var(--font-serif);font-size:var(--text-lg);font-weight:600;color:var(--color-text);line-height:1.3;letter-spacing:-.01em;overflow-wrap:break-word}.post-byline[data-astro-cid-3nssi2tu]{font-size:var(--text-xs);color:var(--color-text-muted);margin-top:-.25rem}.post-deck[data-astro-cid-3nssi2tu]{font-size:var(--text-sm);color:var(--color-text-2);line-height:1.65;overflow-wrap:break-word;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}.post-meta[data-astro-cid-3nssi2tu]{font-size:var(--text-sm);color:var(--color-text-muted);display:flex;gap:.75rem;align-items:center;flex-wrap:wrap;margin-top:auto;padding-top:.75rem;font-variant-numeric:tabular-nums}.badge[data-astro-cid-3nssi2tu]{font-size:var(--text-xs);font-weight:600;padding:.125rem .5rem;border-radius:99px;text-transform:uppercase;letter-spacing:.06em}.badge-published[data-astro-